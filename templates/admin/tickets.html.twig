{% extends "admin/base_admin.html.twig" %}
{% block title %}Tickets - Admin Klevup{% endblock %}
{% block page_title %}Gestion des tickets{% endblock %}
{% block page_subtitle %}Changez le statut et laissez une note — le client la voit dans son portail support.{% endblock %}

{% block admin_styles %}<style>
.ticket-card{background:#fff;border-radius:18px;border:2px solid #E3E9F2;padding:20px;margin-bottom:14px;box-shadow:0 4px 12px rgba(15,36,71,.06)}
.ticket-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.ticket-ref{font-family:monospace;font-weight:700;color:#0F2447;font-size:12px}
.ticket-title{font-weight:700;color:#0F2447;font-size:15px;margin:2px 0}
.ticket-meta{font-size:12px;color:#5A6A80}
.ticket-desc{font-size:13px;color:#1A2332;background:#f8f9fa;border-radius:10px;padding:10px 12px;margin:10px 0}
.priority{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700}
.priority-critical{background:#ffebee;color:#c0392b}
.priority-high{background:#fff3e0;color:#f57c00}
.priority-normal{background:#f5f5f5;color:#666}
.status-new{background:#e3f2fd;color:#1976d2}
.status-in_progress{background:#fff3e0;color:#f57c00}
.status-test{background:#fffbee;color:#ff9800}
.status-resolved{background:#e8f5e9;color:#2E8B57}
.inline-form textarea{flex:1;min-width:240px;min-height:40px;resize:vertical}
.inline-form{align-items:flex-start}
.thread{margin:10px 0;border-left:3px solid #E3E9F2;padding-left:12px}
.thread-msg{font-size:13px;color:#1A2332;margin-bottom:8px;line-height:1.5}
.thread-who{display:block;font-size:11px;font-weight:700;color:#5A6A80}
.thread-msg.staff .thread-who{color:#1D4E89}
</style>{% endblock %}

{% block admin_content %}
{% if tickets|length > 0 %}
  {% for ticket in tickets %}
  <div class="ticket-card">
    <div class="ticket-top">
      <div>
        <span class="ticket-ref">{{ ticket.reference }}</span>
        <div class="ticket-title">{{ ticket.title }}</div>
        <div class="ticket-meta">{{ ticket.user.name }} · {{ {'bug': 'Bug', 'feature': 'Évolution', 'question': 'Question'}[ticket.type]|default(ticket.type) }} · {{ ticket.createdAt|date('d/m/Y') }}</div>
      </div>
      <div>
        <span class="priority priority-{{ ticket.priority }}">● {{ {'critical': 'Critique', 'high': 'Haute', 'normal': 'Normale'}[ticket.priority]|default(ticket.priority) }}</span>
        <span class="status-badge status-{{ ticket.status }}">{{ {'new': 'Nouveau', 'in_progress': 'En cours', 'test': 'En test', 'resolved': 'Résolu'}[ticket.status]|default(ticket.status) }}</span>
      </div>
    </div>
    <div class="ticket-desc">{{ ticket.description }}</div>
    {% if ticket.messages|length > 0 %}
    <div class="thread">
      {% for msg in ticket.messages %}
      <div class="thread-msg {{ msg.author.id == ticket.user.id ? 'client' : 'staff' }}">
        <span class="thread-who">{{ msg.author.id == ticket.user.id ? ticket.user.name : 'Klevup' }} · {{ msg.createdAt|date('d/m H:i') }}</span>
        {{ msg.content|nl2br }}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <form method="post" action="{{ path('admin_ticket_message', {id: ticket.id}) }}" class="inline-form" style="margin-bottom:8px">
      <input type="hidden" name="_token" value="{{ csrf_token('admin_ticket_message_' ~ ticket.id) }}">
      <textarea name="content" placeholder="Répondre au client (email envoyé)…" aria-label="Répondre au client" required></textarea>
      <button type="submit" class="btn-save">Répondre</button>
    </form>
    <form method="post" action="{{ path('admin_ticket_update', {id: ticket.id}) }}" class="inline-form">
      <input type="hidden" name="_token" value="{{ csrf_token('ticket_update_' ~ ticket.id) }}">
      <select name="status" aria-label="Statut du ticket">
        {% for s in statuses %}
        <option value="{{ s }}" {{ ticket.status == s ? 'selected' }}>{{ {'new': 'Nouveau', 'in_progress': 'En cours', 'test': 'En test', 'resolved': 'Résolu'}[s] }}</option>
        {% endfor %}
      </select>
      <textarea name="admin_note" placeholder="Note visible par le client…" aria-label="Note visible par le client">{{ ticket.adminNote }}</textarea>
      <button type="submit" class="btn-save">Enregistrer</button>
    </form>
  </div>
  {% endfor %}
{% else %}
  <div class="empty">Aucun ticket pour le moment.</div>
{% endif %}
{% endblock %}
