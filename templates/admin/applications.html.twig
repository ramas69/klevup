{% extends "admin/base_admin.html.twig" %}
{% block title %}Applications - Admin Klevup{% endblock %}
{% block page_title %}Applications clients{% endblock %}
{% block page_subtitle %}Chaque client voit ses applications dans son portail — et les autres solutions du catalogue qu'il n'a pas encore.{% endblock %}

{% block admin_styles %}<style>
.grid-form{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.btn-create{margin-top:14px}
.inline-form input{width:110px}
@media(max-width:768px){.grid-form{grid-template-columns:1fr}}
</style>{% endblock %}

{% block admin_content %}
<div class="card">
  <h2>Nouvelle application</h2>
  <form method="post" action="{{ path('admin_application_create') }}">
    <input type="hidden" name="_token" value="{{ csrf_token('application_create') }}">
    <div class="grid-form">
      <div class="form-group">
        <label for="app-name">Nom</label>
        <input type="text" id="app-name" name="name" required placeholder="Ex : Formapro Gestion">
      </div>
      <div class="form-group">
        <label for="app-client">Client</label>
        <select id="app-client" name="client_id" required>
          {% for c in clients %}<option value="{{ c.id }}">{{ c.name }} ({{ c.email }})</option>{% endfor %}
        </select>
      </div>
      <div class="form-group">
        <label for="app-product">Produit du catalogue</label>
        <select id="app-product" name="product_id">
          <option value="0">Sur-mesure / hors catalogue</option>
          {% for p in products %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}
        </select>
      </div>
      <div class="form-group">
        <label for="app-url">URL</label>
        <input type="text" id="app-url" name="url" placeholder="app.klevup-apps.fr">
      </div>
      <div class="form-group">
        <label for="app-desc">Description</label>
        <input type="text" id="app-desc" name="description" placeholder="votre plateforme de gestion…">
      </div>
      <div class="form-group">
        <label for="app-version">Version</label>
        <input type="text" id="app-version" name="version" value="1.0">
      </div>
      <div class="form-group">
        <label for="app-launched">Livrée le</label>
        <input type="date" id="app-launched" name="launched_at">
      </div>
      <div class="form-group">
        <label for="app-maint">Maintenance jusqu'au</label>
        <input type="date" id="app-maint" name="maintenance_until">
      </div>
    </div>
    <button type="submit" class="btn-save btn-create">Créer l'application</button>
  </form>
</div>

<div class="panel">
  {% if applications|length > 0 %}
  <table>
    <thead><tr><th>Application</th><th>Client</th><th>URL</th><th>Livrée</th><th>Version / Maintenance / Action</th></tr></thead>
    <tbody>
      {% for a in applications %}
      <tr>
        <td><strong>{{ a.name }}</strong>{% if a.product %} <span style="font-size:11px;color:#1D4E89;font-weight:600">· {{ a.product.name }}</span>{% endif %}<br><span style="font-size:12px;color:#5A6A80">{{ a.description }}</span></td>
        <td>{{ a.client.name }}</td>
        <td style="font-size:12px">{{ a.url }}</td>
        <td>{{ a.launchedAt ? a.launchedAt|date('d/m/Y') : '—' }}</td>
        <td>
          <form method="post" action="{{ path('admin_application_update', {id: a.id}) }}" class="inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('application_update_' ~ a.id) }}">
            <input type="text" name="version" value="{{ a.version }}" title="Version" aria-label="Version">
            <input type="date" name="maintenance_until" value="{{ a.maintenanceUntil ? a.maintenanceUntil|date('Y-m-d') : '' }}" title="Maintenance jusqu'au" aria-label="Maintenance jusqu'au">
            <button type="submit" class="btn-save">Enregistrer</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">Aucune application — créez-en une ci-dessus.</div>
  {% endif %}
</div>
{% endblock %}
