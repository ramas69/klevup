{% extends "admin/base_admin.html.twig" %}
{% block title %}Utilisateurs - Admin Klevup{% endblock %}
{% block page_title %}Utilisateurs{% endblock %}
{% block page_subtitle %}Comptes actifs sur la plateforme.{% endblock %}

{% block topbar_action %}
<a href="{{ path('admin_invite') }}" class="btn btn-gold">+ Nouvelle invitation</a>
{% endblock %}

{% block admin_styles %}<style>
.role-badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700;margin-right:4px}
.role-apporteur{background:#fffbee;color:#ff9800}
.role-client{background:#e3f2fd;color:#1976d2}
.role-admin{background:#ffebee;color:#c0392b}
.status-active{background:#e8f5e9;color:#2E8B57}
.btn-delete{background:#ff6b6b;color:#fff;padding:6px 12px;border-radius:6px;font-size:12px;border:none;cursor:pointer;font-family:Poppins,sans-serif;transition:all .15s}
.btn-delete:hover{background:#ff5252}
</style>{% endblock %}

{% block admin_content %}
<div class="panel">
  {% if users|length > 0 %}
  <table>
    <thead><tr><th>Nom</th><th>Email</th><th>Rôle</th><th>Statut</th><th>Inscrit le</th><th>Actions</th></tr></thead>
    <tbody>
      {% for user in users %}
      <tr>
        <td><strong>{{ user.name }}</strong></td>
        <td style="font-size:13px">{{ user.email }}</td>
        <td>
          {% for role in user.roles %}
            {% if role == 'ROLE_APPORTEUR' %}<span class="role-badge role-apporteur">Apporteur</span>
            {% elseif role == 'ROLE_CLIENT' %}<span class="role-badge role-client">Client</span>
            {% elseif role == 'ROLE_ADMIN' %}<span class="role-badge role-admin">Admin</span>{% endif %}
          {% endfor %}
        </td>
        <td><span class="status-badge status-active">{{ user.status }}</span></td>
        <td>{{ user.createdAt|date('d/m/Y') }}</td>
        <td>
          <form method="post" action="{{ path('admin_user_delete', {id: user.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer cet utilisateur ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
            <button type="submit" class="btn-delete">Supprimer</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">
    <p>Aucun utilisateur pour le moment.</p>
    <a href="{{ path('admin_invite') }}" class="btn btn-gold" style="margin-top:20px">Inviter un utilisateur</a>
  </div>
  {% endif %}
</div>
{% endblock %}
