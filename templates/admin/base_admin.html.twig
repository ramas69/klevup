{% extends "base.html.twig" %}

{% block styles %}
<style>
body{background:#f8f9fa}
.layout{min-height:100vh}
.sidebar{position:fixed;left:0;top:0;width:260px;height:100vh;background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);color:#fff;padding:24px 0;overflow-y:auto;z-index:100}
.sidebar-logo{padding:0 24px 24px;font-weight:700;font-size:19px;border-bottom:1px solid rgba(255,255,255,.15)}
.sidebar-logo small{display:block;font-size:11px;font-weight:600;color:#F5B731;text-transform:uppercase;letter-spacing:1.5px;margin-top:4px}
.sidebar-nav{list-style:none;margin-top:8px}
.sidebar-nav a{display:flex;align-items:center;gap:12px;padding:14px 24px;color:rgba(255,255,255,.75);text-decoration:none;font-weight:500;font-size:14px}
.sidebar-nav a:hover,.sidebar-nav a.active{background:rgba(255,255,255,.1);color:#fff}
.sidebar-nav a::before{content:'●';color:#F5B731;font-size:10px}
.main{margin-left:260px;padding:0 0 32px}
.topbar{background:#fff;padding:32px 24px;margin-bottom:32px;border-bottom:1px solid #E3E9F2}
.tb-in{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.tb-left h1{font-size:28px;font-weight:800;color:#0F2447;margin-bottom:6px}
.tb-left p{font-size:14px;color:#5A6A80}
.section{padding:0 24px}
.flash-success{color:#2E8B57;background:#e8f5e9;border:1px solid #2E8B57;border-radius:12px;padding:12px;margin-bottom:12px;font-size:14px}
.flash-error{color:#C0392B;background:#fdecea;border:1px solid #C0392B;border-radius:12px;padding:12px;margin-bottom:12px;font-size:14px}
.panel{background:#fff;border-radius:18px;overflow:hidden;border:2px solid #E3E9F2;box-shadow:0 4px 12px rgba(15,36,71,.08)}
.card{background:#fff;border-radius:18px;padding:24px;border:2px solid #E3E9F2;margin-bottom:20px;box-shadow:0 4px 12px rgba(15,36,71,.08)}
.card h2{color:#0F2447;font-size:18px;font-weight:700;margin-bottom:16px}
table{width:100%;border-collapse:collapse;font-size:13.5px}
thead th{background:#0F2447;color:#fff;padding:12px 14px;text-align:left;font-weight:700;font-size:11px;text-transform:uppercase}
tbody tr{border-bottom:1px solid #E3E9F2}
tbody tr:nth-child(even){background:#f8f9fa}
tbody td{padding:12px 14px;vertical-align:middle}
.form-group label{display:block;color:#0F2447;font-weight:600;margin-bottom:6px;font-size:13px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:10px;border:2px solid #E3E9F2;border-radius:10px;font-family:Poppins,sans-serif;font-size:13px}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:#F5B731;box-shadow:0 0 0 3px rgba(245,183,49,.1)}
.inline-form{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.inline-form select,.inline-form input,.inline-form textarea{padding:8px 10px;border:2px solid #E3E9F2;border-radius:10px;font-family:Poppins,sans-serif;font-size:13px}
.btn-save{background:#F5B731;color:#0F2447;border:none;padding:8px 16px;border-radius:10px;font-weight:700;font-size:12px;cursor:pointer;font-family:Poppins,sans-serif;transition:all .15s}
.btn-save:hover{filter:brightness(1.06)}
.status-badge{display:inline-block;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px}
.empty{text-align:center;padding:40px;color:#5A6A80;background:#fff;border-radius:18px;border:2px solid #E3E9F2}
@media(max-width:768px){
.sidebar{position:static;width:100%;height:auto;padding:12px 0}
.sidebar-logo{padding:8px 24px 12px}
.sidebar-nav{display:flex;flex-wrap:wrap;margin-top:0}
.sidebar-nav a{padding:10px 14px;font-size:13px}
.sidebar-nav a::before{display:none}
.main{margin-left:0}
.topbar{padding:20px 12px}
.tb-left h1{font-size:22px}
.section{padding:0 12px}
table{font-size:12px}
thead th,tbody td{padding:8px}
}
</style>
{% block admin_styles %}{% endblock %}
{% endblock %}

{% block body %}
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-logo">K Klevup<small>Administration</small></div>
    <ul class="sidebar-nav">
      <li><a href="{{ path('admin_leads') }}" class="{{ app.current_route == 'admin_leads' ? 'active' }}">Leads</a></li>
      <li><a href="{{ path('admin_commissions') }}" class="{{ app.current_route == 'admin_commissions' ? 'active' }}">Commissions</a></li>
      <li><a href="{{ path('admin_tickets') }}" class="{{ app.current_route == 'admin_tickets' ? 'active' }}">Tickets</a></li>
      <li><a href="{{ path('admin_applications') }}" class="{{ app.current_route == 'admin_applications' ? 'active' }}">Applications</a></li>
      <li><a href="{{ path('admin_users') }}" class="{{ app.current_route == 'admin_users' ? 'active' }}">Utilisateurs</a></li>
      <li><a href="{{ path('admin_invite') }}" class="{{ app.current_route == 'admin_invite' ? 'active' }}">Invitations</a></li>
      <li><a href="{{ path('profile') }}">Mon profil</a></li>
      <li><a href="{{ path('logout') }}">Déconnexion</a></li>
    </ul>
  </aside>
  <main class="main">
    <div class="topbar">
      <div class="tb-in">
        <div class="tb-left">
          <h1>{% block page_title %}{% endblock %}</h1>
          <p>{% block page_subtitle %}{% endblock %}</p>
        </div>
        {% block topbar_action %}{% endblock %}
      </div>
    </div>
    <div class="section">
      {% for message in app.flashes('success') %}<div class="flash-success">{{ message }}</div>{% endfor %}
      {% for message in app.flashes('error') %}<div class="flash-error">{{ message }}</div>{% endfor %}
      {% block admin_content %}{% endblock %}
    </div>
  </main>
</div>
{% endblock %}
