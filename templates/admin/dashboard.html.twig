{% extends "admin/base_admin.html.twig" %}
{% block title %}Tableau de bord - Admin Klevup{% endblock %}
{% block page_title %}Tableau de bord{% endblock %}
{% block page_subtitle %}Ce qui se vend, qui apporte, ce qu'il reste à faire.{% endblock %}

{% block admin_styles %}<style>
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px;margin-bottom:24px}
.kpi{background:#fff;border:2px solid #E3E9F2;border-radius:16px;padding:18px;text-decoration:none;color:inherit;display:block}
a.kpi:hover{border-color:#F5B731}
.kpi-l{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:#5A6A80;margin-bottom:6px}
.kpi-v{font-size:26px;font-weight:800;color:#0F2447}
.kpi-v.alert{color:#C0392B}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.panel h2{font-size:15px;color:#0F2447;padding:16px 18px 10px}
.num{text-align:right;font-variant-numeric:tabular-nums}
.muted{color:#5A6A80;font-size:12px}
.warn{color:#C0392B;font-weight:700}
@media(max-width:1300px){.kpis{grid-template-columns:repeat(3,1fr)}}
@media(max-width:1100px){.kpis{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}}
</style>{% endblock %}

{% block admin_content %}
<div class="kpis">
  <a class="kpi" href="{{ path('admin_leads') }}"><div class="kpi-l">Leads à traiter</div><div class="kpi-v {{ kpi.new_leads > 0 ? 'alert' }}">{{ kpi.new_leads }}</div></a>
  <a class="kpi" href="{{ path('admin_tickets') }}"><div class="kpi-l">Tickets ouverts</div><div class="kpi-v">{{ kpi.open_tickets }}</div></a>
  <a class="kpi" href="{{ path('admin_commissions') }}"><div class="kpi-l">Commissions à verser</div><div class="kpi-v">{{ kpi.to_pay|number_format(0, ',', ' ') }} €</div></a>
  <a class="kpi" href="{{ path('admin_invite') }}"><div class="kpi-l">Candidatures apporteurs</div><div class="kpi-v {{ kpi.requests > 0 ? 'alert' }}">{{ kpi.requests }}</div></a>
  <a class="kpi" href="{{ path('admin_applications') }}"><div class="kpi-l">Revenu mensuel (MRR)</div><div class="kpi-v">{{ kpi.mrr|number_format(0, ',', ' ') }} €</div><div class="muted">{{ kpi.subscribers }} abonné{{ kpi.subscribers > 1 ? 's' }}</div></a>
  <div class="kpi"><div class="kpi-l">Setups signés ce trimestre</div><div class="kpi-v">{{ kpi.revenue_quarter|number_format(0, ',', ' ') }} €</div></div>
</div>

<div class="panel" style="margin-bottom:20px">
  <h2>Ventes par solution</h2>
  <table>
    <thead><tr><th>Solution</th><th class="num">Leads</th><th class="num">En cours</th><th class="num">Signés</th><th class="num">Conversion</th><th class="num">Pipeline setup</th><th class="num">Setups signés</th><th class="num">Abos signés</th></tr></thead>
    <tbody>
      {% for row in byProduct %}
      <tr>
        <td><strong>{{ row.name }}</strong></td>
        <td class="num">{{ row.total }}</td>
        <td class="num">{{ row.open }}</td>
        <td class="num">{{ row.signed }}</td>
        <td class="num">{{ row.total > 0 ? ((row.signed / row.total) * 100)|round ~ ' %' : '—' }}</td>
        <td class="num">{{ row.pipeline|number_format(0, ',', ' ') }} €</td>
        <td class="num"><strong>{{ row.revenue|number_format(0, ',', ' ') }} €</strong></td>
        <td class="num">{{ row.monthly|number_format(0, ',', ' ') }} €/mois</td>
      </tr>
      {% else %}
      <tr><td colspan="8" class="muted" style="text-align:center;padding:24px">Aucun lead pour le moment.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<div class="grid2">
  <div class="panel">
    <h2>Apporteurs</h2>
    <table>
      <thead><tr><th>Apporteur</th><th class="num">Leads</th><th class="num">Signés</th><th class="num">CA</th><th class="num">À verser</th></tr></thead>
      <tbody>
        {% for a in byApporteur %}
        <tr>
          <td><strong>{{ a.name }}</strong>{% if not a.iban and (pendingByUser[a.id] ?? 0) > 0 %}<div class="warn" style="font-size:11px">IBAN manquant</div>{% endif %}</td>
          <td class="num">{{ a.total }}</td>
          <td class="num">{{ a.signed }} <span class="muted">({{ a.total > 0 ? ((a.signed / a.total) * 100)|round : 0 }} %)</span></td>
          <td class="num">{{ a.revenue|number_format(0, ',', ' ') }} €</td>
          <td class="num">{{ (pendingByUser[a.id] ?? 0)|number_format(0, ',', ' ') }} €</td>
        </tr>
        {% else %}
        <tr><td colspan="5" class="muted" style="text-align:center;padding:24px">Aucun apporteur actif.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div>
    <div class="panel" style="margin-bottom:20px">
      <h2>Origine des leads</h2>
      <table>
        <thead><tr><th>Canal</th><th class="num">Leads</th><th class="num">Signés</th><th class="num">CA</th></tr></thead>
        <tbody>
          {% for s in bySource %}
          <tr>
            <td>{{ {'apporteur': 'Apporteurs', 'site': 'Site web', 'client': 'Clients existants'}[s.source]|default(s.source) }}</td>
            <td class="num">{{ s.total }}</td>
            <td class="num">{{ s.signed }}</td>
            <td class="num">{{ s.revenue|number_format(0, ',', ' ') }} €</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="muted" style="text-align:center;padding:24px">—</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="panel">
      <h2>Abonnements résiliés en cours</h2>
      <table>
        <thead><tr><th>Application</th><th>Client</th><th class="num">€/mois</th><th>Fin</th></tr></thead>
        <tbody>
          {% for app in ending %}
          <tr>
            <td><strong>{{ app.name }}</strong></td>
            <td>{{ app.client.name }}</td>
            <td class="num">{{ app.monthlyPrice ?? '—' }}</td>
            <td class="warn">{{ app.subscriptionEndsAt|date('d/m/Y') }}</td>
          </tr>
          {% else %}
          <tr><td colspan="4" class="muted" style="text-align:center;padding:24px">Aucune résiliation en cours.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
