{% extends "admin/base_admin.html.twig" %}
{% block title %}Commissions - Admin Klevup{% endblock %}
{% block page_title %}Commissions{% endblock %}
{% block page_subtitle %}Créées automatiquement à la signature d'un lead. Marquez-les encaissées une fois versées.{% endblock %}

{% block admin_styles %}<style>
.amount{font-weight:700;color:#0F2447}
.status-pending{background:#fffbee;color:#ff9800}
.status-encashed{background:#e8f5e9;color:#2E8B57}
.total-bar{background:#FDF9F0;border-top:1px solid #E3E9F2;padding:14px 18px;text-align:right;font-weight:700;color:#0F2447;font-size:14px}
</style>{% endblock %}

{% block admin_content %}
<div class="panel">
  {% if commissions|length > 0 %}
  <table>
    <thead>
      <tr><th>Entreprise</th><th>Solution</th><th>Apporteur</th><th>Créée le</th><th>Montant</th><th>Statut</th><th>Action</th></tr>
    </thead>
    <tbody>
      {% for c in commissions %}
      <tr>
        <td><strong>{{ c.companyName }}</strong></td>
        <td>{{ c.solution }}</td>
        <td>{{ c.user.name }}</td>
        <td>{{ c.createdAt|date('d/m/Y') }}</td>
        <td class="amount">{{ c.amount }} €</td>
        <td><span class="status-badge status-{{ c.status }}">{{ c.status == 'encashed' ? 'Encaissée le ' ~ c.encashedAt|date('d/m/Y') : 'En attente' }}</span></td>
        <td>
          {% if c.status != 'encashed' %}
          <form method="post" action="{{ path('admin_commission_encash', {id: c.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('commission_encash_' ~ c.id) }}">
            <button type="submit" class="btn-save">Marquer encaissée</button>
          </form>
          {% else %}—{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <div class="total-bar">Total en attente : {{ commissions|filter(c => c.status != 'encashed')|map(c => c.amount)|reduce((a, b) => a + b, 0) }} € · Total versé : {{ commissions|filter(c => c.status == 'encashed')|map(c => c.amount)|reduce((a, b) => a + b, 0) }} €</div>
  {% else %}
  <div class="empty">Aucune commission — elles apparaissent quand un lead passe « Signé ».</div>
  {% endif %}
</div>
{% endblock %}
