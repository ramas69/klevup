{% extends "admin/base_admin.html.twig" %}
{% block title %}Invitations - Admin Klevup{% endblock %}
{% block page_title %}Gestion des invitations{% endblock %}
{% block page_subtitle %}Générez des liens d'invitation pour les nouveaux utilisateurs — valables 30 jours, à usage unique.{% endblock %}

{% block admin_styles %}<style>
.card{max-width:640px}
.form-group{margin-bottom:18px}
.success{background:#e8f5e9;border:2px solid #2E8B57;border-radius:12px;padding:16px;margin-top:20px}
.success p{color:#2E8B57;font-size:14px;margin:8px 0}
.invite-link{background:#f8f9fa;padding:12px;border-radius:8px;font-family:monospace;font-size:12px;word-break:break-all;color:#0F2447;border:1px solid #E3E9F2}
.copy-btn{background:#0F2447;color:#fff;padding:8px 16px;border-radius:8px;font-size:12px;cursor:pointer;border:none;font-weight:600;font-family:Poppins,sans-serif;transition:all .15s}
.copy-btn:hover{filter:brightness(1.1)}
</style>{% endblock %}

{% block admin_content %}
<div class="card">
  <h2>Créer un lien d'invitation</h2>
  <form method="post">
    <div class="form-group">
      <label for="role">Rôle de l'invité</label>
      <select name="role" id="role">
        <option value="ROLE_APPORTEUR">Apporteur</option>
        <option value="ROLE_CLIENT">Client</option>
      </select>
    </div>
    <div class="form-group">
      <label for="email">Email de l'invité (optionnel — envoie le lien directement)</label>
      <input type="email" name="email" id="email" placeholder="prenom@entreprise.fr">
    </div>
    <button type="submit" class="btn-save">Générer un lien d'invitation</button>
  </form>

  {% if inviteLink %}
  <div class="success">
    <p><strong>Lien d'invitation généré ✓</strong></p>
    <div class="invite-link">{{ inviteLink }}</div>
    <button class="copy-btn" onclick="navigator.clipboard.writeText('{{ inviteLink }}')">Copier le lien</button>
    <p style="margin-top:12px;font-size:13px">Partagez ce lien avec l'utilisateur invité. Il aura 30 jours pour s'inscrire.</p>
  </div>
  {% endif %}
</div>
{% endblock %}
