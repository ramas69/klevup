{% extends "base.html.twig" %}
{% block title %}Leads - Admin Klevup{% endblock %}
{% block styles %}<style>
body { background: #f8f9fa; }
.admin-page { max-width: 1120px; margin: 0 auto; padding: 40px 24px; }
.admin-header { background: #fff; border-radius: 18px; padding: 30px; margin-bottom: 20px; border: 2px solid #E3E9F2; box-shadow: 0 4px 12px rgba(15, 36, 71, 0.08); }
.admin-header h1 { color: #0F2447; font-size: 28px; font-weight: 700; margin-bottom: 6px; }
.admin-header p { color: #5A6A80; font-size: 14px; }
.admin-nav { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.admin-nav a { padding: 10px 18px; border-radius: 999px; background: #fff; border: 2px solid #E3E9F2; color: #0F2447; text-decoration: none; font-weight: 600; font-size: 13px; transition: all 0.2s; }
.admin-nav a:hover { border-color: #F5B731; }
.admin-nav a.active { background: #0F2447; color: #fff; border-color: #0F2447; }
.flash-success { color: #2E8B57; background: #e8f5e9; border: 1px solid #2E8B57; border-radius: 12px; padding: 12px; margin-bottom: 12px; font-size: 14px; }
.flash-error { color: #C0392B; background: #fdecea; border: 1px solid #C0392B; border-radius: 12px; padding: 12px; margin-bottom: 12px; font-size: 14px; }
.panel { background: #fff; border-radius: 18px; overflow: hidden; border: 2px solid #E3E9F2; box-shadow: 0 4px 12px rgba(15, 36, 71, 0.08); }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
thead th { background: #0F2447; color: #fff; padding: 12px 14px; text-align: left; font-weight: 700; font-size: 11px; text-transform: uppercase; }
tbody tr { border-bottom: 1px solid #E3E9F2; }
tbody tr:nth-child(even) { background: #f8f9fa; }
tbody td { padding: 12px 14px; vertical-align: middle; }
.inline-form { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.inline-form select, .inline-form input[type=number] { padding: 8px 10px; border: 2px solid #E3E9F2; border-radius: 10px; font-family: Poppins, sans-serif; font-size: 13px; }
.inline-form input[type=number] { width: 90px; }
.btn-save { background: #F5B731; color: #0F2447; border: none; padding: 8px 16px; border-radius: 10px; font-weight: 700; font-size: 12px; cursor: pointer; font-family: Poppins, sans-serif; }
.btn-save:hover { filter: brightness(1.06); }
.status-badge { display: inline-block; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px; }
.status-new { background: #e3f2fd; color: #1976d2; }
.status-meeting { background: #fff3e0; color: #f57c00; }
.status-devis { background: #fffbee; color: #ff9800; }
.status-signed { background: #e8f5e9; color: #2E8B57; }
.empty { text-align: center; padding: 40px; color: #5A6A80; }
@media(max-width: 768px){ table { font-size: 12px; } thead th, tbody td { padding: 8px; } }
</style>{% endblock %}
{% block body %}
<div class="admin-page">
  <div class="admin-header">
    <h1>Gestion des leads</h1>
    <p>Faites avancer les leads — le passage à « Signé » crée automatiquement la commission de l'apporteur.</p>
  </div>
  {% include 'admin/_nav.html.twig' %}
  {% for message in app.flashes('success') %}<div class="flash-success">{{ message }}</div>{% endfor %}
  {% for message in app.flashes('error') %}<div class="flash-error">{{ message }}</div>{% endfor %}

  <div class="panel">
    {% if leads|length > 0 %}
    <table>
      <thead>
        <tr><th>Contact</th><th>Solution</th><th>Apporteur</th><th>Reçu le</th><th>Statut</th><th>Commission (€) / Action</th></tr>
      </thead>
      <tbody>
        {% for lead in leads %}
        <tr>
          <td><strong>{{ lead.contact }}</strong></td>
          <td>{{ lead.solution }}</td>
          <td>{{ lead.apporteur.name }}</td>
          <td>{{ lead.createdAt|date('d/m/Y') }}</td>
          <td><span class="status-badge status-{{ lead.status }}">{{ {'new': 'Nouveau', 'meeting': 'RDV planifié', 'devis': 'Devis envoyé', 'signed': 'Signé'}[lead.status]|default(lead.status) }}</span></td>
          <td>
            <form method="post" action="{{ path('admin_lead_update', {id: lead.id}) }}" class="inline-form">
              <input type="hidden" name="_token" value="{{ csrf_token('lead_update_' ~ lead.id) }}">
              <select name="status">
                {% for s in statuses %}
                <option value="{{ s }}" {{ lead.status == s ? 'selected' }}>{{ {'new': 'Nouveau', 'meeting': 'RDV planifié', 'devis': 'Devis envoyé', 'signed': 'Signé'}[s] }}</option>
                {% endfor %}
              </select>
              <input type="number" name="commission" min="0" step="1" value="{{ lead.commission }}">
              <button type="submit" class="btn-save">Enregistrer</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="empty">Aucun lead pour le moment.</div>
    {% endif %}
  </div>
</div>
{% endblock %}
