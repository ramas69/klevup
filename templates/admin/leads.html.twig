{% extends "admin/base_admin.html.twig" %}
{% block title %}Leads - Admin Klevup{% endblock %}
{% block page_title %}Gestion des leads{% endblock %}
{% block page_subtitle %}Faites avancer les leads — le passage à « Signé » crée automatiquement la commission de l'apporteur.{% endblock %}

{% block admin_styles %}<style>
.inline-form input[type=number]{width:90px}
.status-new{background:#e3f2fd;color:#1976d2}
.status-meeting{background:#fff3e0;color:#f57c00}
.status-devis{background:#fffbee;color:#ff9800}
.status-signed{background:#e8f5e9;color:#2E8B57}
.status-lost{background:#f5f5f5;color:#888;text-decoration:line-through}
</style>{% endblock %}

{% block admin_content %}
<div class="panel">
  {% if leads|length > 0 %}
  <table>
    <thead>
      <tr><th>Contact</th><th>Solution</th><th>Apporteur</th><th>Reçu le</th><th>Statut</th><th>Commission (€) / Action</th></tr>
    </thead>
    <tbody>
      {% for lead in leads %}
      <tr>
        <td><strong>{{ lead.contact }}</strong></td>
        <td>{{ lead.solution }}</td>
        <td>{{ lead.apporteur.name }}</td>
        <td>{{ lead.createdAt|date('d/m/Y') }}</td>
        <td><span class="status-badge status-{{ lead.status }}">{{ {'new': 'Nouveau', 'meeting': 'RDV planifié', 'devis': 'Devis envoyé', 'signed': 'Signé', 'lost': 'Sans suite'}[lead.status]|default(lead.status) }}</span></td>
        <td>
          <form method="post" action="{{ path('admin_lead_update', {id: lead.id}) }}" class="inline-form">
            <input type="hidden" name="_token" value="{{ csrf_token('lead_update_' ~ lead.id) }}">
            <select name="status" aria-label="Statut du lead">
              {% for s in statuses %}
              <option value="{{ s }}" {{ lead.status == s ? 'selected' }}>{{ {'new': 'Nouveau', 'meeting': 'RDV planifié', 'devis': 'Devis envoyé', 'signed': 'Signé', 'lost': 'Sans suite'}[s] }}</option>
              {% endfor %}
            </select>
            <input type="number" name="commission" min="0" step="1" value="{{ lead.commission }}" aria-label="Montant commission en euros">
            <button type="submit" class="btn-save">Enregistrer</button>
          </form>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">Aucun lead pour le moment.</div>
  {% endif %}
</div>
{% include 'admin/_pagination.html.twig' %}
{% endblock %}
