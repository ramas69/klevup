{% extends "admin/base_admin.html.twig" %}
{% block title %}Leads - Admin Klevup{% endblock %}
{% block page_title %}Leads{% endblock %}
{% block page_subtitle %}Ouvrez un lead pour le qualifier, saisir le devis et le faire avancer jusqu'à la signature.{% endblock %}

{% block admin_styles %}<style>
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px}
.tabs a{display:inline-flex;gap:8px;align-items:center;padding:9px 16px;border-radius:999px;background:#fff;border:2px solid #E3E9F2;color:#0F2447;text-decoration:none;font-weight:700;font-size:13.5px}
.tabs a:hover{border-color:#F5B731}
.tabs a.on{background:#0F2447;border-color:#0F2447;color:#fff}
.tabs .n{background:#F0F2F5;color:#0F2447;border-radius:999px;padding:1px 8px;font-size:12px}
.tabs a.on .n{background:#F5B731}
.leads tbody tr{cursor:pointer}
.leads tbody tr:hover{background:#FDF9F0 !important}
.co{font-weight:700;color:#0F2447;font-size:14.5px}
.sub{font-size:12.5px;color:#5A6A80;margin-top:2px}
.src{display:inline-block;font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px;text-transform:uppercase;letter-spacing:.5px}
.src-apporteur{background:#fffbee;color:#b9770e}
.src-site{background:#e3f2fd;color:#1976d2}
.src-client{background:#e8f5e9;color:#2E8B57}
.status-new{background:#e3f2fd;color:#1976d2}
.status-meeting{background:#fff3e0;color:#f57c00}
.status-devis{background:#fffbee;color:#b9770e}
.status-signed{background:#e8f5e9;color:#2E8B57}
.status-lost{background:#f0f2f5;color:#888}
.money{font-weight:700;color:#0F2447;white-space:nowrap;font-variant-numeric:tabular-nums}
.money small{display:block;font-weight:500;color:#5A6A80;font-size:11.5px}
.dim{color:#B8C4D4}
.urgent{color:#C0392B;font-weight:700;font-size:11.5px}
.open{display:inline-block;background:#0F2447;color:#fff;text-decoration:none;font-weight:700;font-size:12.5px;padding:8px 14px;border-radius:10px;white-space:nowrap}
@media(max-width:900px){.hide-sm{display:none}}
</style>{% endblock %}

{% block admin_content %}
<nav class="tabs">
  {% for key, t in tabs %}
  <a href="{{ path('admin_leads', key == 'all' ? {} : {tab: key}) }}" class="{{ tab == key ? 'on' }}">{{ t.label }} <span class="n">{{ counts[key] }}</span></a>
  {% endfor %}
</nav>

<div class="panel">
  {% if leads|length > 0 %}
  <table class="leads">
    <thead>
      <tr><th>Prospect</th><th>Solution</th><th class="hide-sm">Origine</th><th>Statut</th><th>Devis</th><th class="hide-sm">Commission</th><th class="hide-sm">Reçu le</th><th></th></tr>
    </thead>
    <tbody>
      {% for lead in leads %}
      {% set url = path('admin_lead_show', {id: lead.id}) %}
      <tr onclick="if(!event.target.closest('a'))location.href='{{ url }}'">
        <td>
          <div class="co">{{ lead.contact }}</div>
          <div class="sub">{{ lead.contactName ?? '' }}{{ lead.contactName and lead.contactRole ? ' · ' }}{{ lead.contactRole ?? '' }}</div>
          {% if lead.timeline == 'urgent' and lead.status not in ['signed', 'lost'] %}<div class="urgent">● Urgent</div>{% endif %}
        </td>
        <td>{{ lead.solution }}</td>
        <td class="hide-sm">
          <span class="src src-{{ lead.source }}">{{ {'apporteur': 'Apporteur', 'site': 'Site web', 'client': 'Client'}[lead.source]|default(lead.source) }}</span>
          {% if lead.apporteur %}<div class="sub">{{ lead.apporteur.name }}</div>{% endif %}
        </td>
        <td>
          <span class="status-badge status-{{ lead.status }}">{{ labels[lead.status]|default(lead.status) }}</span>
          {% if lead.lostReason %}<div class="sub">{{ lostReasons[lead.lostReason]|default('') }}</div>{% endif %}
        </td>
        <td>
          {% if lead.dealAmount %}
          <span class="money">{{ lead.dealAmount|number_format(0, ',', ' ') }} €<small>{{ lead.monthlyAmount ? '+ ' ~ lead.monthlyAmount|number_format(0, ',', ' ') ~ ' €/mois' : 'setup' }}</small></span>
          {% else %}<span class="dim">—</span>{% endif %}
        </td>
        <td class="hide-sm">{% if lead.apporteur and lead.commission > 0 %}<span class="money">{{ lead.commission|number_format(0, ',', ' ') }} €<small>{{ lead.status == 'signed' ? 'due' : 'estimée' }}</small></span>{% else %}<span class="dim">—</span>{% endif %}</td>
        <td class="hide-sm">{{ lead.createdAt|date('d/m/Y') }}</td>
        <td style="text-align:right"><a class="open" href="{{ url }}">Ouvrir</a></td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">Aucun lead dans cette catégorie.</div>
  {% endif %}
</div>
{% include 'admin/_pagination.html.twig' %}
{% endblock %}
