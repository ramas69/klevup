{% if pages > 1 %}
<div class="pagination">
  {% if page > 1 %}<a href="{{ path(app.current_route, {page: page - 1}) }}">← Précédent</a>{% else %}<span class="disabled">← Précédent</span>{% endif %}
  <span class="page-info">Page {{ page }} / {{ pages }}</span>
  {% if page < pages %}<a href="{{ path(app.current_route, {page: page + 1}) }}">Suivant →</a>{% else %}<span class="disabled">Suivant →</span>{% endif %}
</div>
{% endif %}
