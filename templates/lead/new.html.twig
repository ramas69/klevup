{% extends "base.html.twig" %}
{% block title %}Nouveau lead - Klevup{% endblock %}
{% block styles %}<style>
body { background: #f8f9fa; }
.page { max-width: 640px; margin: 0 auto; padding: 40px 24px; }
.nav-back { margin-bottom: 24px; }
.nav-back a { display: inline-flex; align-items: center; gap: 8px; color: #0F2447; text-decoration: none; font-weight: 600; font-size: 14px; padding: 8px 12px; border-radius: 8px; transition: all 0.3s; }
.nav-back a:hover { background: rgba(15, 36, 71, 0.1); }
.card { background: #fff; border-radius: 18px; padding: 30px; border: 2px solid #E3E9F2; box-shadow: 0 4px 12px rgba(15, 36, 71, 0.08); }
.card h1 { color: #0F2447; font-size: 24px; font-weight: 700; margin-bottom: 8px; }
.card p.sub { color: #5A6A80; font-size: 14px; margin-bottom: 24px; }
.form-group { margin-bottom: 18px; }
.form-group label { display: block; color: #0F2447; font-weight: 600; margin-bottom: 8px; font-size: 14px; }
.form-group input, .form-group select { width: 100%; padding: 12px; border: 2px solid #E3E9F2; border-radius: 12px; font-family: Poppins, sans-serif; font-size: 14px; transition: all 0.3s; }
.form-group input:focus, .form-group select:focus { outline: none; border-color: #F5B731; box-shadow: 0 0 0 3px rgba(245, 183, 49, 0.1); }
.form-group small { color: #5A6A80; font-size: 12px; display: block; margin-top: 6px; }
.error { color: #C0392B; background: #fdecea; border: 1px solid #C0392B; border-radius: 12px; padding: 12px; margin-bottom: 20px; font-size: 14px; }
</style>{% endblock %}
{% block body %}
<div class="page">
  <div class="nav-back">
    <a href="{{ path('dashboard') }}">← Retour au tableau de bord</a>
  </div>
  <div class="card">
    <h1>Envoyer un lead</h1>
    <p class="sub">Un contact intéressé par une solution Klevup ? Transmettez-le, on s'occupe du reste.</p>
    {% if error is defined and error %}
      <div class="error">{{ error }}</div>
    {% endif %}
    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('lead_new') }}">
      <div class="form-group">
        <label for="contact">Contact / Entreprise</label>
        <input type="text" id="contact" name="contact" required placeholder="Ex : Cabinet Morel">
      </div>
      <div class="form-group">
        <label for="solution">Solution envisagée</label>
        <select id="solution" name="solution" required>
          <option value="Gestion OF">Gestion OF</option>
          <option value="Prospection">Prospection</option>
          <option value="Site vitrine">Site vitrine</option>
          <option value="Application métier">Application métier</option>
          <option value="Autre">Autre</option>
        </select>
      </div>
      <div class="form-group">
        <label for="commission">Commission estimée (€)</label>
        <input type="number" id="commission" name="commission" min="0" step="1" value="0">
        <small>Estimation indicative — le montant final est confirmé par Klevup à la signature.</small>
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%">Envoyer le lead</button>
    </form>
  </div>
</div>
{% endblock %}
