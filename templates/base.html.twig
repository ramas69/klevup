<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Klevup{% endblock %}</title>
<style>
/* Poppins auto-hébergée (latin) — pas de requête vers Google (RGPD) */
@font-face{font-family:'Poppins';font-style:normal;font-weight:400;font-display:swap;src:url('/fonts/poppins-400.woff2') format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:500;font-display:swap;src:url('/fonts/poppins-500.woff2') format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:600;font-display:swap;src:url('/fonts/poppins-600.woff2') format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:700;font-display:swap;src:url('/fonts/poppins-700.woff2') format('woff2')}
@font-face{font-family:'Poppins';font-style:normal;font-weight:800;font-display:swap;src:url('/fonts/poppins-800.woff2') format('woff2')}
:root{
  --navy:#0F2447; --blue:#1D4E89; --gold:#F5B731; --cream:#FDF9F0;
  --ink:#1A2332; --gray:#5A6A80; --border:#E3E9F2; --success:#2E8B57;
  --grad:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Poppins','Segoe UI',sans-serif;color:var(--ink);background:#fff}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
.btn{display:inline-block;font-weight:700;border-radius:12px;text-decoration:none;cursor:pointer;border:none;font-family:inherit;transition:.15s}
.btn-gold{background:var(--gold);color:var(--navy);padding:13px 26px;font-size:15px}
.btn-gold:hover{filter:brightness(1.06);transform:translateY(-1px)}
/* Shared logo (partials/_logo.html.twig) */
.k-logo{display:inline-flex;align-items:center;gap:calc(var(--k-size) * .28);text-decoration:none;line-height:1}
.k-logo svg{flex-shrink:0;display:block}
.k-logo__text{font-weight:700;font-size:calc(var(--k-size) * .64);letter-spacing:-.5px;color:var(--navy)}
.k-logo__text small{display:block;font-size:11px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-top:5px}
.k-logo--light .k-logo__text{color:#fff}
.k-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
</style>
{% block styles %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
