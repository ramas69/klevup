{% extends "apporteur/base_apporteur.html.twig" %}
{% block title %}Dashboard - Espace Apporteur{% endblock %}
{% block page_title %}Bonjour {{ apporter.name }} 👋{% endblock %}
{% block page_subtitle %}Voici où en sont tes leads et tes commissions — trimestre en cours : T{{ (('now'|date('n')) - 1) // 3 + 1 }} {{ 'now'|date('Y') }}.{% endblock %}

{% block topbar_action %}
<a class="btn btn-gold" href="{{ path('lead_new') }}">+ Envoyer un lead</a>
{% endblock %}

{% block apporteur_styles %}<style>
.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:32px}
.kpi{background:#fff;border:2px solid #E3E9F2;border-radius:18px;padding:24px}
.kpi.feat{background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);color:#fff;border:none}
.kpi-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;opacity:.8;margin-bottom:10px}
.kpi-val{font-size:32px;font-weight:800;color:#F5B731;margin-bottom:4px}
.kpi:not(.feat) .kpi-val{color:#0F2447}
.kpi-note{font-size:13px;opacity:.75}
.badge-green{display:inline-block;background:#2E8B57;color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;margin-top:6px}
.palier{background:#fff;border:3px solid #F5B731;border-radius:18px;padding:24px;margin-bottom:32px}
.palier-head{display:flex;align-items:center;gap:18px;margin-bottom:18px;flex-wrap:wrap}
.palier-icon{font-size:32px;font-weight:800;color:#0F2447}
.palier-text{flex:1}
.palier-text h3{color:#0F2447;font-weight:700;font-size:17px;margin-bottom:4px}
.palier-text p{font-size:14px;color:#5A6A80}
.palier-badge{background:#F5B731;color:#0F2447;font-weight:700;padding:8px 16px;border-radius:999px}
.progress-bar{height:10px;background:#E3E9F2;border-radius:5px;overflow:hidden;margin-top:10px}
.progress-fill{height:100%;background:linear-gradient(90deg,#1D4E89 0%,#F5B731 100%)}
.two-col{display:grid;grid-template-columns:2fr 1fr;gap:18px}
.panel-header{background:#0F2447;color:#fff;padding:18px 24px;font-weight:700}
.status-new{background:#e3f2fd;color:#1976d2}
.status-meeting{background:#fff3e0;color:#f57c00}
.status-devis{background:#fffbee;color:#ff9800}
.status-signed{background:#e8f5e9;color:#2E8B57}
.status-lost{background:#f5f5f5;color:#888;text-decoration:line-through}
.amount{font-weight:700;color:#0F2447}
.amount.green{color:#2E8B57}
.comm-item{border-bottom:1px solid #E3E9F2;padding:14px 18px;display:flex;justify-content:space-between;align-items:center}
.comm-company{font-weight:700;color:#0F2447;margin-bottom:2px}
.comm-date{font-size:12px;color:#5A6A80}
.comm-footer{background:#FDF9F0;border-top:1px solid #E3E9F2;padding:14px 18px;text-align:center;font-weight:700;color:#0F2447}
@media(max-width:1024px){.kpi-row{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}}
@media(max-width:480px){.kpi-row{grid-template-columns:1fr}}
</style>{% endblock %}

{% block apporteur_content %}
<div class="kpi-row">
  <div class="kpi feat">
    <div class="kpi-label">Commissions ce mois</div>
    <div class="kpi-val">{{ apporter.commissions_month }} €</div>
    <div class="kpi-note">Versées après encaissement</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Leads en cours</div>
    <div class="kpi-val">{{ apporter.leads_in_progress }}</div>
  </div>
  <div class="kpi">
    <div class="kpi-label">Ventes signées</div>
    <div class="kpi-val">{{ apporter.sales_signed }}</div>
    <div class="kpi-note">{{ apporter.total_generated }} € générés</div>
  </div>
</div>

{% if not apporter.has_iban %}
<div class="palier" style="border-color:#C0392B;padding:16px 24px">
  <strong style="color:#0F2447">Renseigne ton IBAN</strong> pour recevoir tes commissions par virement — <a href="{{ path('profile') }}" style="color:#1D4E89;font-weight:700">compléter mon profil →</a>
</div>
{% endif %}

{% set remaining = apporter.palier_target - apporter.sales_trimestre %}
<div class="palier">
  <div class="palier-head">
    <div class="palier-icon">{% include 'partials/_logo.html.twig' with {size: 40, wordmark: false} only %}</div>
    <div class="palier-text">
      <h3>{% if remaining <= 0 %}Taux Performance {{ apporter.bonus_rate }} % activé 🎉{% else %}Plus que {{ remaining }} vente{{ remaining > 1 ? 's' }} avant le taux {{ apporter.bonus_rate }} %{% endif %}</h3>
      <p>Commission de {{ apporter.base_rate }} % de la mise en place, puis {{ apporter.bonus_rate }} % dès ta {{ apporter.palier_target + 1 }}ᵉ vente signée du trimestre — plus {{ apporter.recurring_rate }} % de l'abonnement de chaque client pendant {{ apporter.recurring_months }} mois.</p>
    </div>
    <div class="palier-badge">★ {{ apporter.bonus_rate }} %</div>
  </div>
  <div style="display:flex;gap:16px;font-size:13px;font-weight:700;color:#0F2447;margin-bottom:8px">
    <span>{{ apporter.sales_trimestre }} vente{{ apporter.sales_trimestre > 1 ? 's' }} signée{{ apporter.sales_trimestre > 1 ? 's' }} ce trimestre</span>
    <span>Palier : {{ apporter.palier_target }}</span>
  </div>
  <div class="progress-bar"><div class="progress-fill" style="width:{{ min(100, (apporter.sales_trimestre / apporter.palier_target * 100)|round) }}%"></div></div>
</div>

<div class="two-col">
  <div class="panel" id="leads">
    <div class="panel-header">Mes leads</div>
    <table>
      <thead><tr><th>Contact</th><th>Solution</th><th>Statut</th><th>Commission</th></tr></thead>
      <tbody>
        {% for lead in leads %}
        <tr>
          <td><strong>{{ lead.contact }}</strong></td>
          <td>{{ lead.solution }}</td>
          <td><span class="status-badge status-{{ lead.status }}">{{ {'new': 'Nouveau', 'meeting': 'RDV planifié', 'devis': 'Devis envoyé', 'signed': 'Signé 🎉', 'lost': 'Sans suite'}[lead.status]|default(lead.status) }}</span></td>
          <td class="amount {{ lead.status == 'signed' ? 'green' }}">{% if lead.status == 'lost' %}—{% elseif lead.commission > 0 %}{{ lead.status == 'signed' ? '' : '~' }}{{ lead.commission }} €{% else %}<span style="font-weight:500;color:#5A6A80;font-size:12px">au devis</span>{% endif %}</td>
        </tr>
        {% else %}
        <tr><td colspan="4" style="text-align:center;color:#5A6A80;padding:24px">Aucun lead — <a href="{{ path('lead_new') }}" style="color:#F5B731;font-weight:600">envoyez le premier</a></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="panel" id="commissions">
    <div class="panel-header">Mes commissions</div>
    {% for comm in commissions %}
    <div class="comm-item">
      <div>
        <div class="comm-company">{{ comm.company }}</div>
        <div class="comm-date">{% if comm.status == 'encashed' %}Versée le {{ comm.date }}{% else %}En attente{% endif %}</div>
      </div>
      <div class="amount {{ comm.status == 'encashed' ? 'green' }}">{% if comm.status == 'encashed' %}+{{ comm.amount }} €{% else %}à venir{% endif %}</div>
    </div>
    {% else %}
    <div style="text-align:center;color:#5A6A80;padding:24px;font-size:14px">Aucune commission pour le moment.</div>
    {% endfor %}
    <div class="comm-footer"><a href="{{ path('commissions') }}" style="color:inherit;text-decoration:none">Voir toutes mes commissions →</a></div>
  </div>
</div>
{% endblock %}
