{% extends "base.html.twig" %}
{% block title %}Dashboard - Espace Apporteur{% endblock %}
{% block styles %}<style>body{background:#f8f9fa}.layout{display:grid;grid-template-columns:260px 1fr}.sidebar{position:fixed;left:0;top:0;width:260px;height:100vh;background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);color:#fff;padding:24px 0;overflow-y:auto}.sidebar-logo{padding:0 24px 24px;font-weight:700;font-size:19px;border-bottom:1px solid rgba(255,255,255,.15)}.sidebar-nav{list-style:none}.sidebar-nav a{display:flex;align-items:center;gap:12px;padding:14px 24px;color:rgba(255,255,255,.75);text-decoration:none;font-weight:500;font-size:14px}.sidebar-nav a:hover,.sidebar-nav a.active{background:rgba(255,255,255,.1);color:#fff}.sidebar-nav a::before{content:'●';color:#F5B731}.main{margin-left:260px;padding:32px 0}.topbar{background:#fff;padding:32px 24px;margin-bottom:32px;border-bottom:1px solid var(--border)}.tb-in{display:flex;justify-content:space-between;align-items:flex-start}.tb-left h1{font-size:28px;font-weight:800;color:var(--navy);margin-bottom:6px}.tb-left p{font-size:14px;color:var(--gray)}.section{padding:0 24px 32px}.kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:32px}.kpi{background:#fff;border:2px solid var(--border);border-radius:18px;padding:24px}.kpi.feat{background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);color:#fff;border:none}.kpi-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;opacity:.8;margin-bottom:10px}.kpi-val{font-size:32px;font-weight:800;color:#F5B731;margin-bottom:4px}.kpi:not(.feat) .kpi-val{color:var(--navy)}.kpi-note{font-size:13px;opacity:.75}.badge-green{display:inline-block;background:var(--success);color:#fff;font-size:11px;font-weight:700;padding:3px 10px;border-radius:999px;margin-top:6px}.palier{background:#fff;border:3px solid #F5B731;border-radius:18px;padding:24px;margin-bottom:32px}.palier-head{display:flex;align-items:center;gap:18px;margin-bottom:18px}.palier-icon{font-size:32px;font-weight:800;color:var(--navy)}.palier-text h3{color:var(--navy);font-weight:700;font-size:17px;margin-bottom:4px}.palier-text p{font-size:14px;color:var(--gray)}.palier-badge{background:#F5B731;color:var(--navy);font-weight:700;padding:8px 16px;border-radius:999px}.progress-bar{height:10px;background:var(--border);border-radius:5px;overflow:hidden;margin-top:10px}.progress-fill{height:100%;background:linear-gradient(90deg,#1D4E89 0%,#F5B731 100%);width:50%}.two-col{display:grid;grid-template-columns:2fr 1fr;gap:18px}.panel{background:#fff;border-radius:18px;overflow:hidden}.panel-header{background:var(--navy);color:#fff;padding:18px 24px;font-weight:700}.panel-body{padding:0}table{width:100%;border-collapse:collapse;font-size:14px}thead th{background:var(--navy);color:#fff;padding:14px 18px;text-align:left;font-weight:700;font-size:12px}tbody tr{border-bottom:1px solid var(--border)}tbody td{padding:14px 18px}tbody tr:nth-child(even){background:#f3f7fc}.status-badge{display:inline-block;font-size:11px;font-weight:700;padding:4px 10px;border-radius:999px}.status-new{background:#e3f2fd;color:#1976d2}.status-meet{background:#fff3e0;color:#f57c00}.status-devis{background:#fffbee;color:#ff9800}.status-sign{background:#e8f5e9;color:var(--success)}.amount{font-weight:700;color:var(--navy)}.amount.green{color:var(--success)}.comm-item{border-bottom:1px solid var(--border);padding:14px 18px;display:flex;justify-content:space-between;align-items:center}.comm-company{font-weight:700;color:var(--navy);margin-bottom:2px}.comm-date{font-size:12px;color:var(--gray)}.comm-footer{background:var(--cream);border-top:1px solid var(--border);padding:14px 18px;text-align:center;font-weight:700;color:var(--navy)}@media(max-width:1024px){.kpi-row{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}}@media(max-width:768px){.layout{grid-template-columns:1fr}.sidebar{position:fixed;left:0;top:0;width:100%;height:auto;background:#fff;color:var(--navy);padding:0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;z-index:100}.sidebar-logo{padding:16px 24px;border:none;margin:0}.sidebar-nav{display:none;flex-direction:row;gap:0;background:var(--grad);color:#fff;position:absolute;top:60px;left:0;right:0;padding:0;flex-basis:100%}.sidebar-nav.active{display:flex}.sidebar-nav a{padding:12px 16px;flex:1;text-align:center;border-right:1px solid rgba(255,255,255,.1)}.sidebar-nav a::before{display:none}.main{margin-left:0;padding:80px 0 32px;width:100%}.topbar{padding:16px 12px}.tb-in{flex-direction:column;gap:12px}.tb-left h1{font-size:20px}.tb-left p{font-size:12px}.section{padding:0 12px 20px}.kpi-row{grid-template-columns:1fr;gap:12px}.kpi{padding:16px}.kpi-label{font-size:10px}.kpi-val{font-size:24px}.palier-head{flex-direction:column;text-align:center}.palier-text h3{font-size:15px}.two-col{grid-template-columns:1fr}table{font-size:12px}thead th,tbody td{padding:8px 10px}}@media(max-width:480px){.topbar{padding:12px 8px}.section{padding:0 8px 16px}.kpi{padding:12px}.kpi-val{font-size:20px}.kpi-label{font-size:9px}.palier{padding:16px}.palier-badge{padding:6px 12px;font-size:13px}table{font-size:11px}thead th,tbody td{padding:6px 8px}.comm-item{flex-direction:column;align-items:flex-start;padding:10px}.comm-date{font-size:11px}}</style>{% endblock %}
{% block body %}<div class="layout"><aside class="sidebar"><div class="sidebar-logo">K Klevup</div><ul class="sidebar-nav"><li><a href="{{ path('dashboard') }}" class="active">Tableau de bord</a></li><li><a href="#">Mes leads</a></li><li><a href="#">Mes commissions</a></li><li><a href="#">Fiches solutions</a></li><li><a href="#">Aide & contact</a></li></ul></aside><main class="main"><div class="topbar"><div class="tb-in"><div class="tb-left"><h1>Bonjour {{ apporter.name }} 👋</h1><p>Voici où en sont tes leads et tes commissions — trimestre en cours : T3 2026.</p></div><a class="btn btn-gold" href="#">+ Envoyer un lead</a></div></div><div class="section"><div class="kpi-row"><div class="kpi feat"><div class="kpi-label">Commissions ce mois</div><div class="kpi-val">{{ apporter.commissions_month }} €</div><div class="kpi-note">Prochain versement : 15 juillet</div></div><div class="kpi"><div class="kpi-label">Leads en cours</div><div class="kpi-val">{{ apporter.leads_in_progress }}</div><div class="badge-green">↗ 2 nouveaux cette semaine</div></div><div class="kpi"><div class="kpi-label">Ventes signées</div><div class="kpi-val">{{ apporter.sales_signed }}</div><div class="kpi-note">{{ apporter.total_generated }} € générés</div><div class="badge-green">↗ +3 ce trimestre</div></div></div><div class="palier"><div class="palier-head"><div class="palier-icon">K</div><div class="palier-text"><h3>Plus qu'une vente pour passer à 20 %</h3><p>Ta {{ apporter.palier_target }}ᵉ vente du trimestre déclenche le taux Performance sur toutes les suivantes.</p></div><div class="palier-badge">★ 20 %</div></div><div style="display:flex;gap:16px;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:8px"><span>{{ apporter.sales_trimestre }} ventes ce trimestre</span><span>Palier : {{ apporter.palier_target }}</span></div><div class="progress-bar"><div class="progress-fill"></div></div></div><div class="two-col"><div class="panel"><div class="panel-header">Mes leads</div><div class="panel-body"><table><thead><tr><th>Contact</th><th>Solution</th><th>Statut</th><th>Commission</th></tr></thead><tbody>{% for lead in leads %}<tr><td><strong>{{ lead.contact }}</strong></td><td>{{ lead.solution }}</td><td><span class="status-badge status-{{ lead.status }}">{% if lead.status == 'new' %}Nouveau{% elseif lead.status == 'meeting' %}RDV planifié{% elseif lead.status == 'devis' %}Devis envoyé{% elseif lead.status == 'signed' %}Signé 🎉{% endif %}</span></td><td class="amount {% if lead.status == 'signed' %}green{% endif %}">~{{ lead.commission }} €</td></tr>{% endfor %}</tbody></table></div></div><div class="panel"><div class="panel-header">Mes commissions</div><div class="panel-body">{% for comm in commissions %}<div class="comm-item"><div><div class="comm-company">{{ comm.company }}</div><div class="comm-date">{% if comm.status == 'encashed' %}Encaissé {{ comm.date }}{% else %}En attente{% endif %}</div></div><div class="amount {% if comm.status == 'encashed' %}green{% endif %}">{% if comm.status == 'encashed' %}+{{ comm.amount }} €{% else %}à venir{% endif %}</div></div>{% endfor %}<div class="comm-footer">Versement 15 juillet — {{ apporter.commissions_month }} €</div></div></div></div></div></main></div>{% endblock %}
