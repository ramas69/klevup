{% extends "base.html.twig" %}
{% block title %}Nouvelle demande - Support Klevup{% endblock %}
{% block styles %}<style>
body { background: #f8f9fa; }
.page { max-width: 640px; margin: 0 auto; padding: 40px 24px; }
.nav-back { margin-bottom: 24px; }
.nav-back a { display: inline-flex; align-items: center; gap: 8px; color: #0F2447; text-decoration: none; font-weight: 600; font-size: 14px; padding: 8px 12px; border-radius: 8px; transition: all 0.3s; }
.nav-back a:hover { background: rgba(15, 36, 71, 0.1); }
.card { background: #fff; border-radius: 18px; padding: 30px; border: 2px solid #E3E9F2; box-shadow: 0 4px 12px rgba(15, 36, 71, 0.08); }
.card h1 { color: #0F2447; font-size: 24px; font-weight: 700; margin-bottom: 8px; }
.card p.sub { color: #5A6A80; font-size: 14px; margin-bottom: 24px; }
.form-group { margin-bottom: 18px; }
.form-group label { display: block; color: #0F2447; font-weight: 600; margin-bottom: 8px; font-size: 14px; }
.form-group input, .form-group select, .form-group textarea { width: 100%; padding: 12px; border: 2px solid #E3E9F2; border-radius: 12px; font-family: Poppins, sans-serif; font-size: 14px; transition: all 0.3s; }
.form-group textarea { min-height: 120px; resize: vertical; }
.form-group input:focus, .form-group select:focus, .form-group textarea:focus { outline: none; border-color: #F5B731; box-shadow: 0 0 0 3px rgba(245, 183, 49, 0.1); }
.row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.error { color: #C0392B; background: #fdecea; border: 1px solid #C0392B; border-radius: 12px; padding: 12px; margin-bottom: 20px; font-size: 14px; }
@media(max-width: 480px){ .row-2 { grid-template-columns: 1fr; } }
</style>{% endblock %}
{% block body %}
{% include 'client/_topbar.html.twig' %}
<div class="page">
  <div class="card">
    <h1>Nouvelle demande</h1>
    <p class="sub">Décrivez votre problème ou votre idée — nous accusons réception sous 24 h ouvrées.</p>
    {% if error is defined and error %}
      <div class="error">{{ error }}</div>
    {% endif %}
    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('ticket_new') }}">
      <div class="form-group">
        <label for="title">Titre</label>
        <input type="text" id="title" name="title" required placeholder="Ex : Export PDF vide sur certaines sessions">
      </div>
      <div class="row-2">
        <div class="form-group">
          <label for="type">Type</label>
          <select id="type" name="type">
            <option value="bug">Bug / problème</option>
            <option value="feature">Demande d'évolution</option>
            <option value="question">Question</option>
          </select>
        </div>
        <div class="form-group">
          <label for="priority">Priorité</label>
          <select id="priority" name="priority">
            <option value="normal">Normale</option>
            <option value="high">Haute</option>
            <option value="critical">Critique — bloque mon activité</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" required placeholder="Que s'est-il passé ? Sur quelle page ? Depuis quand ?"></textarea>
      </div>
      <button type="submit" class="btn btn-gold" style="width:100%">Envoyer la demande</button>
    </form>
  </div>
</div>
{% endblock %}
