{% extends "base.html.twig" %}
{% block title %}Nouveau mot de passe - Klevup{% endblock %}
{% block styles %}<style>
.auth-page { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: linear-gradient(135deg, #0F2447 0%, #1D4E89 70%, #2A6DB5 100%); padding: 20px; }
.auth-card { background: white; border-radius: 18px; padding: 40px; box-shadow: 0 16px 48px rgba(0,0,0,.2); max-width: 400px; width: 100%; }
.auth-card h1 { text-align: center; color: #0F2447; font-size: 24px; margin-bottom: 10px; }
.auth-card p { text-align: center; color: #5A6A80; font-size: 14px; margin-bottom: 24px; }
.form-group { margin-bottom: 20px; }
.form-group label { display: block; color: #0F2447; font-weight: 600; margin-bottom: 8px; font-size: 14px; }
.form-group input { width: 100%; padding: 12px; border: 2px solid #E3E9F2; border-radius: 12px; font-family: Poppins, sans-serif; font-size: 14px; }
.form-group input:focus { outline: none; border-color: #F5B731; }
.btn-submit { width: 100%; padding: 14px; background: #F5B731; color: #0F2447; border: none; border-radius: 12px; font-weight: 700; font-size: 16px; cursor: pointer; margin-top: 8px; }
.btn-submit:hover { filter: brightness(1.06); }
.error { color: #C0392B; background: #fdecea; border: 1px solid #C0392B; border-radius: 12px; padding: 12px; margin-bottom: 20px; font-size: 13px; }
</style>{% endblock %}
{% block body %}
<div class="auth-page">
  <div class="auth-card">
    <h1>Nouveau mot de passe</h1>
    <p>Choisissez votre nouveau mot de passe (8 caractères minimum).</p>
    {% if error is defined and error %}<div class="error">{{ error }}</div>{% endif %}
    <form method="post">
      <input type="hidden" name="_token" value="{{ csrf_token('reset_password') }}">
      <div class="form-group">
        <label for="password">Nouveau mot de passe</label>
        <input type="password" id="password" name="password" required minlength="8" autofocus>
      </div>
      <button type="submit" class="btn-submit">Enregistrer</button>
    </form>
  </div>
</div>
{% endblock %}
