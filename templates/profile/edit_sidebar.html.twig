{% extends layout %}
{% block title %}Mon profil - Klevup{% endblock %}
{% block page_title %}Mon profil{% endblock %}
{% block page_subtitle %}{{ app.user.email }}{% endblock %}

{% set profile_css %}
<style>
.profile-card{max-width:640px}
.pw-sep{color:#0F2447;font-size:16px;font-weight:700;margin:24px 0 12px;padding-top:20px;border-top:1px solid #E3E9F2}
.form-group{margin-bottom:18px}
.form-group label{display:block;color:#0F2447;font-weight:600;margin-bottom:6px;font-size:13px}
.form-group input{width:100%;padding:11px;border:2px solid #E3E9F2;border-radius:10px;font-family:Poppins,sans-serif;font-size:14px}
.form-group input:focus{outline:none;border-color:#F5B731;box-shadow:0 0 0 3px rgba(245,183,49,.1)}
.form-group small{color:#5A6A80;font-size:12px;display:block;margin-top:6px}
.profile-card .card,.card.profile-card{padding:28px}
</style>
{% endset %}

{% block admin_styles %}{{ profile_css }}{% endblock %}
{% block apporteur_styles %}{{ profile_css }}
<style>
.card{background:#fff;border-radius:18px;padding:24px;border:2px solid #E3E9F2;box-shadow:0 4px 12px rgba(15,36,71,.08)}
</style>
{% endblock %}

{% block admin_content %}
<div class="card profile-card">{% include 'profile/_form.html.twig' %}</div>
{% endblock %}

{% block apporteur_content %}
<div class="card profile-card">{% include 'profile/_form.html.twig' %}</div>
{% endblock %}
