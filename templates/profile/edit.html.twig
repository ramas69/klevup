{% extends "base.html.twig" %}
{% block title %}Mon profil - Klevup{% endblock %}
{% block styles %}<style>
body { background: #f8f9fa; }
.page { max-width: 640px; margin: 0 auto; padding: 40px 24px; }
.nav-back { margin-bottom: 24px; }
.nav-back a { display: inline-flex; align-items: center; gap: 8px; color: #0F2447; text-decoration: none; font-weight: 600; font-size: 14px; padding: 8px 12px; border-radius: 8px; transition: all 0.3s; }
.nav-back a:hover { background: rgba(15, 36, 71, 0.1); }
.card { background: #fff; border-radius: 18px; padding: 30px; border: 2px solid #E3E9F2; box-shadow: 0 4px 12px rgba(15, 36, 71, 0.08); }
.card h1 { color: #0F2447; font-size: 24px; font-weight: 700; margin-bottom: 8px; }
.card p.sub { color: #5A6A80; font-size: 14px; margin-bottom: 24px; }
.pw-sep { color: #0F2447; font-size: 17px; font-weight: 700; margin: 24px 0 12px; padding-top: 20px; border-top: 1px solid #E3E9F2; }
.form-group { margin-bottom: 18px; }
.form-group label { display: block; color: #0F2447; font-weight: 600; margin-bottom: 8px; font-size: 14px; }
.form-group input { width: 100%; padding: 12px; border: 2px solid #E3E9F2; border-radius: 12px; font-family: Poppins, sans-serif; font-size: 14px; transition: all 0.3s; }
.form-group input:focus { outline: none; border-color: #F5B731; box-shadow: 0 0 0 3px rgba(245, 183, 49, 0.1); }
.form-group small { color: #5A6A80; font-size: 12px; display: block; margin-top: 6px; }
.flash-success { color: #2E8B57; background: #e8f5e9; border: 1px solid #2E8B57; border-radius: 12px; padding: 12px; margin-bottom: 16px; font-size: 14px; }
.flash-error { color: #C0392B; background: #fdecea; border: 1px solid #C0392B; border-radius: 12px; padding: 12px; margin-bottom: 16px; font-size: 14px; }
</style>{% endblock %}
{% block body %}
<div class="page">
  <div class="nav-back">
    <a href="{{ path('support') }}">← Retour au support</a>
  </div>
  <div class="card">
    <h1>Mon profil</h1>
    <p class="sub">{{ app.user.email }}</p>
    {% for message in app.flashes('success') %}<div class="flash-success">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="flash-error">{{ message }}</div>{% endfor %}
    {% include 'profile/_form.html.twig' %}
  </div>
</div>
{% endblock %}
