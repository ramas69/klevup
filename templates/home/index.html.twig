{% extends "base.html.twig" %}

{% block title %}Klevup — Les applications intelligentes qui font monter votre business{% endblock %}

{% block styles %}
<style>
.btn-ghost{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.6);padding:12px 24px;font-size:15px}
.btn-ghost:hover{border-color:#fff}
.hero{background:var(--grad);color:#fff;padding:88px 0 96px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.eyebrow{display:inline-block;background:rgba(245,183,49,.15);border:1px solid var(--gold);color:var(--gold);font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:22px}
h1{font-size:52px;font-weight:800;letter-spacing:-1.5px;line-height:1.12;color:#fff}
h1 em{font-style:normal;color:var(--gold)}
.hero p{margin:22px 0 34px;font-size:18px;color:#CFE0F5;line-height:1.65;max-width:520px}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap}
.hero-note{margin-top:18px;font-size:13.5px;color:#9FB6D6}
.hero-card{background:#fff;border-radius:22px;padding:28px;color:var(--ink);box-shadow:0 24px 60px rgba(4,12,28,.45);transform:rotate(1.5deg)}
.hc-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--border);font-size:14px}
.hc-row:last-child{border:none}
.hc-badge{background:#E2EFDA;color:var(--success);font-size:11.5px;font-weight:700;border-radius:999px;padding:3px 10px}
.hc-price{font-weight:800;color:var(--navy)}
.proof{background:var(--cream);padding:22px 0;text-align:center;font-size:14px;color:var(--gray);font-weight:500}
.proof b{color:var(--navy)}
section{padding:84px 0}
.sec-head{text-align:center;max-width:640px;margin:0 auto 52px}
.sec-head h2{font-size:34px;font-weight:700;color:var(--navy);letter-spacing:-.5px}
.sec-head p{margin-top:14px;color:var(--gray);font-size:16.5px;line-height:1.6}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
.card{background:#fff;border:2px solid var(--border);border-radius:18px;padding:28px;position:relative}
.card.hl{border:3px solid var(--gold)}
.card .tag{position:absolute;top:-13px;left:24px;background:var(--gold);color:var(--navy);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;padding:4px 12px;border-radius:999px}
.card h3{color:var(--navy);font-size:19px;font-weight:700;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.card .arr{color:var(--gold);font-size:20px}
.card p{color:var(--gray);font-size:14.5px;line-height:1.6}
.card .price{margin-top:16px;font-weight:800;color:var(--navy);font-size:17px}
.card .price span{font-weight:500;color:var(--gray);font-size:13px}
.steps{background:var(--cream)}
.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.step{background:#fff;border:2px solid var(--border);border-radius:18px;padding:30px 26px}
.step .n{width:44px;height:44px;border-radius:12px;background:var(--grad);color:#fff;font-weight:800;font-size:19px;display:flex;align-items:center;justify-content:center;margin-bottom:18px}
.step h3{color:var(--navy);font-size:17.5px;margin-bottom:8px}
.step p{color:var(--gray);font-size:14.5px;line-height:1.6}
.apporteur{background:var(--grad);color:#fff}
.apporteur .wrap{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.apporteur h2{font-size:32px;font-weight:700;letter-spacing:-.5px;line-height:1.25;color:#fff}
.apporteur h2 em{font-style:normal;color:var(--gold)}
.apporteur p{margin:18px 0 26px;color:#CFE0F5;font-size:16px;line-height:1.65}
.stat-cards{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.stat{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);border-radius:18px;padding:22px;text-align:center}
.stat .v{font-size:34px;font-weight:800;color:var(--gold)}
.stat .l{font-size:13px;color:#CFE0F5;margin-top:4px}
.final{text-align:center}
.final h2{font-size:34px;font-weight:700;color:var(--navy);letter-spacing:-.5px}
.final p{color:var(--gray);margin:14px auto 30px;max-width:520px;font-size:16.5px}
.lead-form{max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:12px;text-align:left}
.lead-form .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.lead-form input,.lead-form select,.lead-form textarea{width:100%;padding:13px 14px;border:2px solid var(--border);border-radius:12px;font-family:inherit;font-size:15px;background:#fff;color:var(--ink)}
.lead-form input:focus,.lead-form select:focus,.lead-form textarea:focus{outline:none;border-color:var(--gold)}
.lead-form.dark{margin:0}
.lead-form.dark input,.lead-form.dark textarea{border-color:rgba(255,255,255,.25)}
.lead-form .btn{align-self:flex-start}
.final .lead-form .btn{align-self:center}
.lead-form .rgpd{font-size:12.5px;margin:0;text-align:center}
.lead-form .rgpd a{color:var(--blue)}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}
.flash{max-width:560px;margin:0 auto 14px;border-radius:12px;padding:12px 14px;font-size:14.5px;font-weight:600;text-align:left}
.flash.ok{background:#E2EFDA;color:var(--success)}
.flash.ko{background:#fdecea;color:#C0392B}
.apporteur .flash{margin:0 0 14px}
@media(max-width:860px){
  .hero .wrap,.apporteur .wrap{grid-template-columns:1fr}
  .grid,.steps-grid,.lead-form .row2{grid-template-columns:1fr}
  h1{font-size:38px}
}
.anything{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--navy);color:#CFE0F5;border-radius:18px;padding:22px 26px;margin-top:28px;font-size:15.5px;line-height:1.6}
.anything strong{color:#fff}
.anything .btn{white-space:nowrap}
.faq{background:var(--cream)}
.faq-list{max-width:760px;margin:0 auto}
.faq-item{background:#fff;border:2px solid var(--border);border-radius:14px;margin-bottom:12px;overflow:hidden}
.faq-item summary{cursor:pointer;padding:18px 22px;font-weight:700;color:var(--navy);font-size:16px;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';font-size:22px;color:var(--gold);font-weight:800}
.faq-item[open] summary::after{content:'−'}
.faq-item .a{padding:0 22px 18px;color:var(--gray);font-size:14.5px;line-height:1.65}
</style>
{% endblock %}

{% block body %}
{% include 'partials/_public_header.html.twig' %}

<header class="hero">
  <div class="wrap">
    <div>
      <span class="eyebrow">Votre équipe tech & IA externalisée</span>
      {% set setupPrices = products|map(p => p.priceFrom)|filter(v => v > 0) %}
      {% set setupFrom = setupPrices|length ? min(setupPrices) : 0 %}
      {% set monthlyPrices = products|map(p => p.monthlyFrom)|filter(v => v > 0) %}
      {% set monthlyFrom = monthlyPrices|length ? min(monthlyPrices) : 0 %}
      <h1>Vos applications et automatisations IA, <em>prêtes en quelques jours</em>.</h1>
      <p>Solutions prêtes, agents IA ou sur mesure, livrés à votre marque{% if setupFrom %} dès {{ setupFrom|number_format(0, ',', ' ') }} €{% endif %}. Hébergement, maintenance et support inclus.</p>
      <div class="hero-ctas">
        <a class="btn btn-gold" href="#contact">Demander une démo gratuite</a>
        <a class="btn btn-ghost" href="#solutions">Voir les solutions</a>
      </div>
      <div class="hero-note">✓ Tout compris &nbsp; ✓ Livraison rapide &nbsp; ✓ Équipe française</div>
    </div>
    <div class="hero-card">
      <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
        {% include 'partials/_logo.html.twig' with {size: 40, wordmark: false} only %}
        <div><div style="font-weight:700;color:var(--navy)">Votre projet Klevup</div><div style="font-size:12.5px;color:var(--gray)">Suivi de livraison</div></div>
      </div>
      <div class="hc-row"><span>Maquette validée</span><span class="hc-badge">Fait</span></div>
      <div class="hc-row"><span>Personnalisation à votre marque</span><span class="hc-badge">Fait</span></div>
      <div class="hc-row"><span>Formation de votre équipe</span><span class="hc-badge">En cours</span></div>
      <div class="hc-row"><span>Mise en ligne</span><span style="color:var(--gray);font-size:13px">J+10</span></div>
      <div class="hc-row"><span style="font-weight:700;color:var(--navy)">Mise en place</span><span class="hc-price">{{ setupFrom ? 'dès ' ~ setupFrom|number_format(0, ',', ' ') ~ ' €' : 'sur devis' }}</span></div>
      <div class="hc-row"><span style="font-weight:700;color:var(--navy)">Abonnement tout compris</span><span class="hc-price">{{ monthlyFrom ? 'dès ' ~ monthlyFrom|number_format(0, ',', ' ') ~ ' €/mois' : 'mensuel' }}</span></div>
    </div>
  </div>
</header>

<div class="proof"><div class="wrap">Choisi par des <b>organismes de formation</b>, des <b>formateurs</b> et des <b>TPE</b>.</div></div>

<section id="solutions">
  <div class="wrap">
    <div class="sec-head">
      <h2>Nos solutions</h2>
      <p>Prêtes à l'emploi, ou sur mesure.</p>
    </div>
    <div class="grid">
      {% for p in products %}
      <div class="card {{ p.featured ? 'hl' }}">{% if p.featured %}<span class="tag">La plus demandée</span>{% endif %}<h3><span class="arr">↗</span> {{ p.name }}</h3><p>{{ p.description }}</p><div class="price">Mise en place dès {{ p.priceFrom|number_format(0, ',', ' ') }} €{% if p.monthlyFrom %} <span>+ {{ p.monthlyFrom|number_format(0, ',', ' ') }} €/mois tout compris</span>{% endif %}</div></div>
      {% endfor %}
    </div>
    <div class="anything">
      <div><strong>Pas dans la liste ?</strong> On étudie tout : devis sous 48 h{% if setupFrom %}, dès {{ setupFrom|number_format(0, ',', ' ') }} €{% endif %}.</div>
      <a class="btn btn-gold" href="#contact">Décrire mon besoin</a>
    </div>
  </div>
</section>

<section class="steps" id="comment">
  <div class="wrap">
    <div class="sec-head"><h2>Comment ça marche</h2></div>
    <div class="steps-grid">
      <div class="step"><div class="n">1</div><h3>On échange 30 minutes</h3><p>Démo et devis ferme sous 48 h.</p></div>
      <div class="step"><div class="n">2</div><h3>On livre à votre marque</h3><p>En quelques jours, pas en quelques mois.</p></div>
      <div class="step"><div class="n">3</div><h3>On s'occupe du reste</h3><p>Formation, hébergement, maintenance et support inclus.</p></div>
    </div>
  </div>
</section>

<section class="apporteur" id="apporteur">
  <div class="wrap">
    <div>
      <h2>Vous connaissez des entreprises qui en ont besoin ? <em>Devenez apporteur.</em></h2>
      <p>Vous recommandez, on s'occupe de tout. Vous touchez {{ rates.setup }} % de la mise en place, puis {{ rates.recurring }} % de l'abonnement pendant {{ rates.months }} mois.</p>
      <div style="margin:-6px 0 22px"><a href="{{ path('apporteur_page') }}" style="color:var(--gold);font-weight:700;text-decoration:underline">Détail des commissions →</a></div>
      {% for m in app.flashes('apporteur_success') %}<div class="flash ok">{{ m }}</div>{% endfor %}
      {% for m in app.flashes('apporteur_error') %}<div class="flash ko">{{ m }}</div>{% endfor %}
      <form method="post" action="{{ path('apporteur_request') }}" class="lead-form dark">
        <input type="hidden" name="_token" value="{{ csrf_token('apporteur_request') }}">
        <input type="hidden" name="ref" value="{{ ref }}">
        <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="row2">
          <input type="text" name="name" required maxlength="255" placeholder="Nom et prénom" aria-label="Nom et prénom">
          <input type="email" name="email" required maxlength="180" placeholder="Email" aria-label="Email">
        </div>
        <input type="tel" name="phone" maxlength="30" placeholder="Téléphone (optionnel)" aria-label="Téléphone">
        <textarea name="message" rows="2" maxlength="2000" placeholder="Votre réseau en deux mots (secteur, type de contacts…)" aria-label="Votre réseau"></textarea>
        <button type="submit" class="btn btn-gold">Rejoindre le réseau apporteurs</button>
      </form>
    </div>
    <div class="stat-cards">
      <div class="stat"><div class="v">{{ rates.setup }} %</div><div class="l">de la mise en place</div></div>
      <div class="stat"><div class="v">{{ rates.recurring }} %</div><div class="l">de l'abonnement, {{ rates.months }} mois</div></div>
      <div class="stat"><div class="v">{{ rates.setup + rates.bonus }} %</div><div class="l">dès la {{ rates.palier + 1 }}ᵉ vente du trimestre</div></div>
      <div class="stat"><div class="v">{{ rates.paymentDays }} j</div><div class="l">pour être payé</div></div>
    </div>
  </div>
</section>

<section class="faq" id="faq">
  <div class="wrap">
    <div class="sec-head"><h2>Questions fréquentes</h2></div>
    <div class="faq-list">
      <details class="faq-item"><summary>À qui appartiennent mes données ?</summary><div class="a">À vous. Vous pouvez les exporter à tout moment (CSV/Excel).</div></details>
      <details class="faq-item"><summary>Et si j'arrête l'abonnement ?</summary><div class="a">On vous remet une exportation complète de vos données. Aucun frais de sortie.</div></details>
      <details class="faq-item"><summary>En combien de temps suis-je opérationnel ?</summary><div class="a">Quelques jours pour une solution prête ; un calendrier précis avec le devis pour le sur-mesure.</div></details>
      <details class="faq-item"><summary>Qui est derrière Klevup ?</summary><div class="a">Une équipe française qui développe vos outils et forme vos équipes à s'en servir.</div></details>
    </div>
  </div>
</section>

<section class="final" id="contact">
  <div class="wrap">
    <h2>Parlons de votre projet</h2>
    <p>30 minutes, sans engagement, prix ferme.</p>
    {% for m in app.flashes('demo_success') %}<div class="flash ok">{{ m }}</div>{% endfor %}
    {% for m in app.flashes('demo_error') %}<div class="flash ko">{{ m }}</div>{% endfor %}
    <form method="post" action="{{ path('demo_request') }}" class="lead-form">
      <input type="hidden" name="_token" value="{{ csrf_token('demo') }}">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <div class="row2">
        <input type="text" name="contact" required maxlength="255" placeholder="Entreprise *" aria-label="Entreprise">
        <input type="text" name="contact_name" maxlength="255" placeholder="Votre nom" aria-label="Votre nom">
      </div>
      <div class="row2">
        <input type="email" name="email" required maxlength="180" placeholder="Email *" aria-label="Email">
        <input type="tel" name="phone" maxlength="30" placeholder="Téléphone" aria-label="Téléphone">
      </div>
      <select name="product_id" aria-label="Solution qui vous intéresse">
        {% for p in products %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}
        <option value="0">Autre besoin — on étudie tout</option>
      </select>
      <textarea name="notes" rows="3" maxlength="2000" placeholder="Votre besoin en quelques mots" aria-label="Votre besoin"></textarea>
      <button type="submit" class="btn btn-gold" style="font-size:17px;padding:16px 34px">Demander une démo gratuite</button>
      <p class="rgpd">Vos coordonnées servent uniquement à vous recontacter au sujet de votre demande. <a href="{{ path('legal_privacy') }}">Confidentialité</a></p>
    </form>
    <p style="margin-top:16px;font-size:13.5px">ou écrivez-nous : <a href="mailto:contact@klevup.fr" style="color:var(--blue);font-weight:600">contact@klevup.fr</a></p>
  </div>
</section>

{% include 'partials/_public_footer.html.twig' %}
{% endblock %}
