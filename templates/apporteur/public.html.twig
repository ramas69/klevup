{% extends "base.html.twig" %}

{% block title %}Devenir apporteur Klevup — {{ (3000 * rates.setup / 100)|round }} € par client apporté, puis un revenu qui coule{% endblock %}

{% block styles %}
<style>
.hero{background:var(--grad);color:#fff;padding:70px 0 80px}
.eyebrow{display:inline-block;background:rgba(245,183,49,.15);border:1px solid var(--gold);color:var(--gold);font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:6px 14px;border-radius:999px;margin-bottom:22px}
h1{font-size:44px;font-weight:800;letter-spacing:-1.2px;line-height:1.15;color:#fff}
h1 em{font-style:normal;color:var(--gold)}
.hero p{margin:20px 0 0;font-size:17.5px;color:#CFE0F5;line-height:1.65;max-width:640px}
section{padding:70px 0}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
.sec-head{text-align:center;max-width:660px;margin:0 auto 46px}
.sec-head h2{font-size:30px;font-weight:700;color:var(--navy);letter-spacing:-.5px}
.sec-head p{margin-top:12px;color:var(--gray);font-size:16px;line-height:1.6}
.calc{background:var(--cream);border-radius:22px;padding:44px 40px;max-width:820px;margin:0 auto}
.calc h2{font-size:26px;color:var(--navy);margin-bottom:6px}
.calc .hint{color:var(--gray);font-size:14px;margin-bottom:26px;font-family:Arial,sans-serif}
.calc-grid{display:grid;grid-template-columns:1fr 1fr;gap:34px;align-items:start}
.calc label{display:block;font-family:Arial,sans-serif;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:10px;text-transform:uppercase;letter-spacing:1px}
.calc input[type=range]{width:100%;accent-color:var(--blue)}
.calc .val{font-size:22px;font-weight:800;color:var(--navy);font-family:Arial,sans-serif}
.resultbox{background:var(--navy);border-radius:18px;padding:30px;color:#fff;text-align:center}
.resultbox .big{font-size:44px;font-weight:800;color:var(--gold)}
.resultbox .l1{font-size:13px;color:#9FB6D6;margin-top:2px}
.resultbox .y{font-size:20px;font-weight:700;color:#fff;margin-top:16px;padding-top:14px;border-top:1px solid rgba(255,255,255,.2)}
.chrono{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.ch{background:#fff;border:2px solid var(--border);border-radius:16px;padding:24px 20px;text-align:center}
.ch .n{width:40px;height:40px;border-radius:10px;background:var(--grad);color:#fff;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.ch h3{font-size:15.5px;color:var(--navy);margin-bottom:6px}
.ch p{font-size:13.5px;color:var(--gray);line-height:1.55}
.triggers{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.tr{background:#fff;border:2px solid var(--border);border-left:5px solid var(--gold);border-radius:12px;padding:16px 18px;font-size:14.5px;color:var(--ink);line-height:1.5}
.tr b{color:var(--navy)}
.kit{background:var(--cream)}
.kit-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.kit-card{background:#fff;border:2px solid var(--border);border-radius:14px;padding:20px}
.kit-card h3{font-size:15px;color:var(--navy);margin-bottom:10px}
.kit-card pre{white-space:pre-wrap;font-family:Georgia,serif;font-size:13px;line-height:1.55;color:var(--ink);background:#FAF7F0;border-radius:8px;padding:12px}
.guar{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.g{background:#fff;border:2px solid var(--border);border-radius:14px;padding:20px;text-align:center;font-size:14px;color:var(--gray);line-height:1.5}
.g b{color:var(--navy);display:block;font-size:15.5px;margin-bottom:6px}
.cta{background:var(--grad);color:#fff;text-align:center;padding:70px 0}
.cta h2{font-size:30px;color:#fff;letter-spacing:-.5px}
.cta p{color:#CFE0F5;margin:14px auto 26px;max-width:560px;font-size:16px}
.btn-gold{background:var(--gold);color:var(--navy);border:none;border-radius:10px;padding:15px 34px;font-size:16px;font-weight:800;text-decoration:none;display:inline-block;cursor:pointer}
@media(max-width:860px){.calc-grid,.triggers,.kit-grid,.guar,.chrono{grid-template-columns:1fr}h1{font-size:32px}}
</style>
{% endblock %}

{% block body %}
{% include 'partials/_public_header.html.twig' %}

<header class="hero">
  <div class="wrap">
    <span class="eyebrow">Réseau apporteurs Klevup</span>
    <h1>{{ (3000 * rates.setup / 100)|round|number_format(0, ',', ' ') }} € par client apporté.<br><em>Puis un revenu qui coule {{ rates.months }} mois.</em></h1>
    <p>Vous transmettez un contact. On s'occupe de tout : démo, devis, livraison, support.
    Vous touchez {{ rates.setup }} % de la mise en place, puis {{ rates.recurring }} % de l'abonnement pendant {{ rates.months }} mois.
    Vous n'appelez personne, vous ne vendez rien, vous ne gérez rien après.</p>
  </div>
</header>

<section>
  <div class="wrap">
    <div class="calc">
      <h2>Vos commissions, en euros réels</h2>
      <div class="hint">Bougez les curseurs — le calcul se met à jour instantanément.</div>
      <div class="calc-grid">
        <div>
          <label>Prix de la mise en place : <span class="val" id="v1">3 000 €</span></label>
          <input type="range" min="2000" max="15000" step="500" value="3000" id="r1" oninput="calc()">
          <label style="margin-top:22px">Abonnement mensuel : <span class="val" id="v2">150 €</span></label>
          <input type="range" min="80" max="600" step="10" value="150" id="r2" oninput="calc()">
          <label style="margin-top:22px">Clients apportés par mois : <span class="val" id="v3">1</span></label>
          <input type="range" min="1" max="6" step="1" value="1" id="r3" oninput="calc()">
        </div>
        <div class="resultbox">
          <div class="big" id="r_immediate">—</div>
          <div class="l1">commission immédiate par client ({{ rates.setup }} %)</div>
          <div class="y" id="r_year">—</div>
          <div class="l1" style="margin-top:2px">+ récurrent {{ rates.recurring }} % × {{ rates.months }} mois, après un an de portefeuille</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><h2>Ton rôle, en 4 étapes</h2><p>Tu ne vends rien, tu ne gères rien — tu écoutes et tu transmets.</p></div>
    <div class="chrono">
      <div class="ch"><div class="n">1</div><h3>Tu repères un besoin</h3><p>Dans tes conversations : un formateur, un artisan, un commerce qui galère avec ses outils.</p></div>
      <div class="ch"><div class="n">2</div><h3>Tu transmets le contact</h3><p>Ton lien de recommandation ou ton nom dans le formulaire. C'est tout.</p></div>
      <div class="ch"><div class="n">3</div><h3>On s'occupe de tout</h3><p>Démo sous 48 h, devis ferme, livraison, formation du client, support. Tu n'es plus dans la boucle.</p></div>
      <div class="ch"><div class="n">4</div><h3>Tu encaisses</h3><p>{{ rates.setup }} % de la mise en place à la signature, puis {{ rates.recurring }} % de l'abonnement chaque mois pendant {{ rates.months }} mois.</p></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><h2>Les conversations qui déclenchent tout</h2><p>Si tu entends une de ces phrases, tu as un prospect. Clique, tu verras combien ça vaut pour toi.</p></div>
    <div class="triggers">
      <div class="tr"><b>« Je gère mes inscriptions et mes émargements sur Excel »</b> — un organisme de formation. Mise en place dès 3 000 € → {{ (3000 * rates.setup / 100)|round|number_format(0, ',', ' ') }} € pour toi.</div>
      <div class="tr"><b>« Je veux vendre mes formations en ligne »</b> — un formateur qui veut sa plateforme e-learning à sa marque.</div>
      <div class="tr"><b>« La prospection me prend des heures chaque semaine »</b> — un consultant ou agence qui veut outiller son acquisition.</div>
      <div class="tr"><b>« Je veux que mes clients commandent en ligne »</b> — un artisan, un producteur, un commerce de proximité.</div>
      <div class="tr"><b>« On paye trois outils qui ne se parlent pas »</b> — une TPE qui veut une seule application à son image.</div>
      <div class="tr"><b>« Un outil sur mesure ? Trop cher, trop long »</b> — et c'est là que tu parles de nous : quelques jours, dès 2 000 €.</div>
    </div>
  </div>
</section>

<section class="kit">
  <div class="wrap">
    <div class="sec-head"><h2>Ton kit de recommandation — copier, coller, envoyer</h2><p>Trois messages prêts. Remplace les crochets, c'est parti.</p></div>
    <div class="kit-grid">
      <div class="kit-card"><h3>LinkedIn / WhatsApp — la version directe</h3><pre>Bonjour [Prénom], je suis tombé sur Klevup — une équipe française qui livre des applications métier clés en main (inscriptions, émargements, e-learning, prise de commande) à la marque du client, en quelques jours, dès 2 000 € puis un abonnement tout compris.

Je pense à toi pour [raison]. Une démo gratuite de 30 min pour voir ? Je te mets en contact directement.</pre></div>
      <div class="kit-card"><h3>La version douce (prospect hésitant)</h3><pre>[Prénom], tu m'avais dit que [irritant : tu perds du temps avec tes inscriptions / tes devis]. Je connais une équipe qui règle exactement ça — application à ta marque, prête en quelques jours, pas de projet interminable.

Je t'introduis ? C'est gratuit, sans engagement — et la démo vaut le détour rien que pour voir comment c'est fait.</pre></div>
      <div class="kit-card"><h3>La version groupe / post</h3><pre>Je connais une équipe française (Klevup) qui livre des applications métier clés en main : organisme de formation, e-learning, prospection, prise de commande. À ta marque, en quelques jours, dès 2 000 €, puis un abonnement tout compris (hébergement, maintenance, support).

Si votre gestion tourne encore sur Excel et trois outils dispersés, ça vaut 30 minutes de démo. Contactez-moi, je vous présente.</pre></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="sec-head"><h2>Les garanties du réseau</h2><p>Ce qu'on t'écrit noir sur blanc.</p></div>
    <div class="guar">
      <div class="g"><b>24 h pour prendre en charge</b>Ton contact reçoit sa démo sous 48 h. Ta réputation n'attend pas.</div>
      <div class="g"><b>Commission à {{ rates.paymentDays }} jours</b>Payée dans les {{ rates.paymentDays }} jours suivant la signature du client. Le récurrent tombe chaque mois tant que le client règle.</div>
      <div class="g"><b>Ta relation reste la tienne</b>Pas de démarchage abusif en ton nom : on recommande, on livre, on chouchoute — et le client sait qui l'a envoyé.</div>
    </div>
  </div>
</section>

<section class="cta" id="rejoindre">
  <div class="wrap">
    <h2>Une question avant de rejoindre ?</h2>
    <p>Remplis le formulaire en 2 minutes : qui tu es, ton réseau, et on t'appelle. Si ce n'est pas fait pour toi, on te le dira franchement.</p>
    {% for m in app.flashes('apporteur_success') %}<div class="flash ok" style="max-width:560px;margin:0 auto 14px;border-radius:12px;padding:12px 14px;font-size:14.5px;font-weight:600;background:#E2EFDA;color:var(--success)">{{ m }}</div>{% endfor %}
    {% for m in app.flashes('apporteur_error') %}<div class="flash ko" style="max-width:560px;margin:0 auto 14px;border-radius:12px;padding:12px 14px;font-size:14.5px;font-weight:600;background:#fdecea;color:#C0392B">{{ m }}</div>{% endfor %}
    <form method="post" action="{{ path('apporteur_request') }}" class="lead-form" style="max-width:560px;margin:0 auto;display:flex;flex-direction:column;gap:12px;text-align:left">
      <input type="hidden" name="_token" value="{{ csrf_token('apporteur_request') }}">
      <input type="hidden" name="ref" value="{{ ref }}">
      <input type="hidden" name="_back" value="page">
      <input type="text" name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <input type="text" name="name" required maxlength="255" placeholder="Nom et prénom" aria-label="Nom et prénom" style="padding:13px 14px;border:2px solid rgba(255,255,255,.25);border-radius:12px;font-size:15px;background:rgba(255,255,255,.08);color:#fff">
        <input type="email" name="email" required maxlength="180" placeholder="Email" aria-label="Email" style="padding:13px 14px;border:2px solid rgba(255,255,255,.25);border-radius:12px;font-size:15px;background:rgba(255,255,255,.08);color:#fff">
      </div>
      <input type="tel" name="phone" maxlength="30" placeholder="Téléphone (optionnel)" aria-label="Téléphone" style="padding:13px 14px;border:2px solid rgba(255,255,255,.25);border-radius:12px;font-size:15px;background:rgba(255,255,255,.08);color:#fff">
      <textarea name="message" rows="2" maxlength="2000" placeholder="Ton réseau en deux mots (secteur, type de contacts…)" aria-label="Ton réseau" style="padding:13px 14px;border:2px solid rgba(255,255,255,.25);border-radius:12px;font-size:15px;background:rgba(255,255,255,.08);color:#fff;font-family:inherit"></textarea>
      <button type="submit" class="btn-gold" style="align-self:center">Rejoindre le réseau apporteurs</button>
    </form>
  </div>
</section>

{% include 'partials/_public_footer.html.twig' %}

<script>
function calc(){
  const setup=+document.getElementById('r1').value;
  const monthly=+document.getElementById('r2').value;
  const clients=+document.getElementById('r3').value;
  document.getElementById('v1').textContent=setup.toLocaleString('fr-FR')+' €';
  document.getElementById('v2').textContent=monthly+' €';
  document.getElementById('v3').textContent=clients+(clients>1?' clients':' client');
  const R={setup:{{ rates.setup }}/100,recurring:{{ rates.recurring }}/100,months:{{ rates.months }}};
  const immediate=setup*R.setup;
  const recur=monthly*R.recurring*R.months;
  const monthlyPortfolio=clients*(monthly*R.recurring);
  document.getElementById('r_immediate').textContent=immediate.toLocaleString('fr-FR')+' €';
  document.getElementById('r_year').textContent='Avec un an de portefeuille : '+Math.round(clients*12*(immediate+recur)).toLocaleString('fr-FR')+' € — dont '+Math.round(clients*12*monthlyPortfolio).toLocaleString('fr-FR')+' €/mois de récurrent à la 12ᵉ';
}
calc();
</script>
{% endblock %}
