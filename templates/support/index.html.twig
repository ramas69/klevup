{% extends "base.html.twig" %}
{% block title %}Support Client - Klevup{% endblock %}
{% block styles %}<style>body{background:#f8f9fa}.header{background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);color:#fff;padding:48px 0}.header-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}.header-logo{font-weight:700;font-size:18px}.header-links{display:flex;gap:28px;list-style:none}.header-links a{color:rgba(255,255,255,.75);text-decoration:none;font-weight:500}.avatar{width:40px;height:40px;background:#F5B731;color:var(--navy);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700}.header-greet{margin-bottom:8px;font-size:18px;font-weight:700}.header-sub{font-size:14px;color:#CFE0F5}.container{max-width:1120px;margin:0 auto;padding:0 24px}.app-card{background:#fff;border-radius:18px;padding:24px;margin:-32px auto 32px;box-shadow:0 12px 32px rgba(15,36,71,.12);display:flex;gap:18px;align-items:flex-start;position:relative;z-index:2}.app-card+.app-card{margin-top:-16px}.app-icon{width:52px;height:52px;background:linear-gradient(135deg,#0F2447 0%,#1D4E89 70%,#2A6DB5 100%);border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:24px}.app-info{flex:1}.app-name{font-weight:700;font-size:16px;color:var(--navy);margin-bottom:4px}.app-detail{font-size:13px;color:var(--gray);margin-bottom:10px}.app-badges{display:flex;gap:12px;flex-wrap:wrap}.badge{padding:6px 14px;border-radius:18px;font-size:12px;font-weight:700;display:inline-flex;gap:6px}.badge-ok{background:#e8f5e9;color:var(--success)}.badge-maint{background:var(--cream);color:var(--navy);border:1px solid var(--border)}.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:32px}.stat{background:#fff;border-radius:18px;padding:20px;border:2px solid var(--border)}.stat-label{font-size:12px;font-weight:700;text-transform:uppercase;color:var(--gray);margin-bottom:8px}.stat-val{font-size:28px;font-weight:800;color:var(--navy)}.stat-detail{font-size:12px;color:var(--gray);margin-top:6px}.tickets{background:#fff;border-radius:18px;margin-bottom:32px;overflow:hidden}.tickets-header{background:var(--navy);color:#fff;padding:18px 24px;font-weight:700}.filters{display:flex;gap:12px;padding:14px 24px;background:#f8f9fa}.filter-btn{padding:8px 16px;border-radius:18px;border:none;background:#fff;color:var(--navy);cursor:pointer;font-weight:700;font-size:13px}.filter-btn.active{background:var(--navy);color:#fff}table{width:100%;border-collapse:collapse;font-size:13.5px}thead th{background:var(--navy);color:#fff;padding:12px 18px;text-align:left;font-weight:700;font-size:11px}tbody tr{border-bottom:1px solid var(--border)}tbody td{padding:12px 18px}tbody tr:nth-child(even){background:#f8f9fa}.ticket-ref{font-weight:700;color:var(--navy);font-family:monospace;font-size:12px}.ticket-title{font-weight:700;color:var(--navy);margin-bottom:3px}.ticket-type{font-size:11px;color:var(--gray)}.priority{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700}.priority-crit{background:#ffebee;color:#c0392b}.priority-high{background:#fff3e0;color:#f57c00}.priority-norm{background:#f5f5f5;color:#666}.status{display:inline-block;padding:4px 10px;border-radius:999px;font-size:11px;font-weight:700}.status-test{background:#fffbee;color:#ff9800}.status-prog{background:#fff3e0;color:#f57c00}.status-done{background:#e8f5e9;color:var(--success)}.banner{background:var(--cream);border:2px dashed #F5B731;border-radius:18px;padding:28px;text-align:center}.banner h3{color:var(--navy);font-weight:700;margin-bottom:10px}.banner p{color:var(--gray);margin-bottom:18px}@media(max-width:768px){.header-top{flex-direction:column;gap:12px}.header-logo{order:2}.header-links{order:1;gap:12px;font-size:13px}.avatar{order:3}.header-greet{font-size:16px}.header-sub{font-size:13px}.container{padding:0 12px}.app-card{flex-direction:column;padding:16px;margin:-24px auto 20px}.app-icon{width:44px;height:44px;font-size:20px}.app-detail{font-size:12px;margin-bottom:8px}.stats-row{grid-template-columns:repeat(2,1fr);gap:12px}.stat{padding:14px;border-radius:14px}.stat-label{font-size:10px;margin-bottom:6px}.stat-val{font-size:24px}.stat-detail{font-size:11px}.tickets{margin-bottom:24px}.tickets-header{padding:14px 16px;font-size:14px}.filters{padding:10px 16px;gap:8px}.filter-btn{padding:6px 12px;font-size:12px;border-radius:14px}table{font-size:11.5px}thead th,tbody td{padding:8px 10px}.ticket-title{font-size:13px;margin-bottom:2px}.ticket-type{font-size:10px}.banner{padding:16px}.banner h3{font-size:15px;margin-bottom:8px}.banner p{font-size:12px;margin-bottom:14px}}@media(max-width:480px){.header{padding:24px 0}.header-top{gap:8px}.header-logo{font-size:14px}.header-links a{font-size:11px}.header-greet{font-size:14px}.header-sub{font-size:12px}.container{padding:0 8px}.app-card{padding:12px;gap:12px}.app-icon{width:40px;height:40px}.app-detail{font-size:11px;margin-bottom:6px}.stats-row{grid-template-columns:1fr;gap:10px}.stat{padding:12px}.stat-label{font-size:9px}.stat-val{font-size:22px}.tickets-header{padding:12px}.table{font-size:10px}thead th,tbody td{padding:6px 8px}.priority,.status{padding:3px 8px;font-size:10px}.banner{padding:14px}.banner h3{font-size:13px}.banner p{font-size:11px}}</style>{% endblock %}
{% block body %}<div class="header"><div class="container"><div class="header-top"><div class="header-logo">K Klevup · Support</div><ul class="header-links"><li><a href="#tickets">Mes demandes</a></li><li><a href="{{ path('profile') }}">Mon profil</a></li><li><a href="{{ path('logout') }}">Déconnexion</a></li></ul><div class="avatar">{{ client.name|slice(0,1) }}</div></div><div class="header-greet">Bonjour {{ client.name }}, comment pouvons-nous vous aider ?</div><div class="header-sub">Suivez ici vos signalements et demandes d'évolution — notre équipe vous répond sous 24 h ouvrées.</div></div></div><div class="container">{% for message in app.flashes('error') %}<div style="color:#C0392B;background:#fdecea;border:1px solid #C0392B;border-radius:12px;padding:12px;margin:12px 0;font-size:14px;position:relative;z-index:3">{{ message }}</div>{% endfor %}{% for message in app.flashes('success') %}<div style="color:#2E8B57;background:#e8f5e9;border:1px solid #2E8B57;border-radius:12px;padding:12px;margin:12px 0;font-size:14px;position:relative;z-index:3">{{ message }}</div>{% endfor %}{% for application in applications %}<div class="app-card"><div class="app-icon">K</div><div class="app-info"><div class="app-name">{{ application.name }}</div><div class="app-detail">{{ application.description }}</div><div class="app-detail">Livrée le {{ application.launch_date }} · version {{ application.version }}{% if application.url %} · <a href="{{ application.url starts with 'http' ? application.url : 'https://' ~ application.url }}" target="_blank" rel="noopener" style="color:inherit">{{ application.url }}</a>{% endif %}</div><div class="app-badges">{% if application.maintenance_until %}{% if application.maintenance_expired %}<div class="badge badge-maint" style="background:#fdecea;color:#C0392B">Maintenance expirée le {{ application.maintenance_until }}</div>{% else %}<div class="badge badge-maint">Maintenance active jusqu'au {{ application.maintenance_until }}</div>{% endif %}{% endif %}{% if application.maintenance_expiring %}<form method="post" action="{{ path('client_renew', {id: application.id}) }}" style="display:inline"><input type="hidden" name="_token" value="{{ csrf_token('client_renew_' ~ application.id) }}"><button type="submit" class="badge badge-ok" style="border:none;cursor:pointer;font-family:inherit">Renouveler ma maintenance →</button></form>{% endif %}</div></div></div>{% endfor %}<div class="stats-row"><div class="stat"><div class="stat-label">Demandes en cours</div><div class="stat-val">{{ client.requests_in_progress }}</div></div><div class="stat"><div class="stat-label">Résolues ce mois</div><div class="stat-val">{{ client.resolved_this_month }}</div></div><div class="stat"><div class="stat-label">Temps de réponse moyen</div><div class="stat-val">{{ client.response_time }}</div><div class="stat-detail">Engagement : 24 h</div></div></div><div class="tickets" id="tickets"><div class="tickets-header">Mes demandes</div><div class="filters"><button class="filter-btn active" data-filter="all">Toutes</button><button class="filter-btn" data-filter="open">En cours</button><button class="filter-btn" data-filter="resolved">Résolues</button></div><table><thead><tr><th>Réf.</th><th>Demande</th><th>Priorité</th><th>Dernière mise à jour</th><th>Statut</th></tr></thead><tbody>{% for ticket in tickets %}<tr data-status="{{ ticket.status }}"><td class="ticket-ref">{{ ticket.ref }}</td><td><div class="ticket-title"><a href="{{ path('ticket_show', {id: ticket.id}) }}" style="color:inherit;text-decoration:none">{{ ticket.title }} →</a></div><div class="ticket-type">{{ {'bug': 'Bug', 'feature': 'Demande d\'évolution', 'question': 'Question'}[ticket.type]|default(ticket.type) }} · {{ ticket.date }}</div></td><td><span class="priority priority-{% if ticket.priority == 'critical' %}crit{% elseif ticket.priority == 'high' %}high{% else %}norm{% endif %}">● {% if ticket.priority == 'critical' %}Critique{% elseif ticket.priority == 'high' %}Haute{% else %}Normale{% endif %}</span></td><td><div style="font-size:13px;color:var(--gray);line-height:1.5">{{ ticket.note }}</div></td><td><span class="status status-{{ {'new': 'prog', 'in_progress': 'prog', 'test': 'test', 'resolved': 'done'}[ticket.status]|default('prog') }}">{{ {'new': 'Reçue', 'in_progress': 'En cours', 'test': 'En test', 'resolved': 'Résolu ✓'}[ticket.status]|default(ticket.status) }}</span></td></tr>{% endfor %}</tbody></table></div><div class="banner"><h3>Un problème ou une idée d'amélioration ?</h3><p>Décrivez-le en 2 minutes — notre équipe vous répond sous 24 h ouvrées.</p><a class="btn btn-gold" href="{{ path('ticket_new') }}">+ Nouvelle demande</a></div>{% if suggestions|length > 0 %}<div class="tickets" style="margin-top:24px"><div class="tickets-header">Nos autres solutions</div><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;padding:18px">{% for p in suggestions %}<div style="border:2px solid #E3E9F2;border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:8px"><strong style="color:#0F2447">{{ p.name }}</strong><span style="font-size:13px;color:#5A6A80;line-height:1.5;flex:1">{{ p.description }}</span><span style="font-size:13px;font-weight:700;color:#0F2447">Dès {{ p.priceFrom|number_format(0, ',', ' ') }} € · paiement unique</span><form method="post" action="{{ path('client_interest', {id: p.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('client_interest_' ~ p.id) }}"><button type="submit" class="btn btn-gold" style="padding:9px 16px;font-size:13px">Ça m'intéresse</button></form></div>{% endfor %}</div></div>{% endif %}</div>
<script>
document.querySelectorAll('.filter-btn').forEach(function (btn) {
  btn.addEventListener('click', function () {
    document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active'); });
    btn.classList.add('active');
    var filter = btn.dataset.filter;
    document.querySelectorAll('#tickets tbody tr').forEach(function (row) {
      var resolved = row.dataset.status === 'resolved';
      row.style.display = (filter === 'all' || (filter === 'resolved' && resolved) || (filter === 'open' && !resolved)) ? '' : 'none';
    });
  });
});
</script>
{% endblock %}
